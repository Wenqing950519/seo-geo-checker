{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "geocheck-developer-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "api.geocheck.lisheng.cv", "custom_domain": true }
  ],
  "vars": {
    "DEVELOPER_API_QUOTA_WINDOW_STRATEGY": "rolling_24h",
    "DEVELOPER_API_RESULT_RETENTION_DAYS": "30",
    "DEVELOPER_API_TRIAL_DAYS": "7",
    "DEVELOPER_API_FREE_ROUNDS_PER_WINDOW": "3",
    "DEVELOPER_API_DAILY_BUDGET_TWD": "60",
    "DEVELOPER_API_MONTHLY_BUDGET_TWD": "600",
    "DEVELOPER_API_MAX_JOB_COST_TWD": "12",
    "DEVELOPER_API_TWD_PER_USD": "31.535"
  },
  "d1_databases": [{
    "binding": "DEVELOPER_DB",
    "database_name": "geocheck-developer-api",
    "database_id": "cebce923-e5a4-460e-abf3-68bf5096e67c",
    "migrations_dir": "../../api/developer-api-migrations"
  }],
  "queues": {
    "producers": [{ "binding": "DEVELOPER_MEASUREMENTS", "queue": "geocheck-developer-measurements" }],
    "consumers": [{
      "queue": "geocheck-developer-measurements",
      "max_batch_size": 1,
      "max_batch_timeout": 5,
      "max_retries": 3,
      "dead_letter_queue": "geocheck-developer-measurements-dlq"
    }]
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
