{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "geocheck-audit-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "geocheck.lslabs.tw/api/*", "zone_name": "lslabs.tw" },
    { "pattern": "geocheck.lslabs.tw/report/*", "zone_name": "lslabs.tw" },
    { "pattern": "geocheck.lisheng.cv/api/*", "zone_name": "lisheng.cv" },
    { "pattern": "geocheck.lisheng.cv/report/*", "zone_name": "lisheng.cv" }
  ],
  "browser": { "binding": "BROWSER" },
  "d1_databases": [{
    "binding": "REPORTS_DB",
    "database_name": "geocheck-reports",
    "database_id": "dc0c172d-3042-42a2-a77b-cc57a6d8a0e9",
    "migrations_dir": "../../api/migrations"
  }],
  "queues": {
    "producers": [{ "binding": "AUDIT_JOBS", "queue": "geocheck-audit-jobs" }],
    "consumers": [{ "queue": "geocheck-audit-jobs", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 1, "dead_letter_queue": "geocheck-audit-jobs-dlq" }]
  },
  "containers": [{
    "class_name": "AuditFallbackContainer",
    "image": "./Dockerfile",
    "image_build_context": "../../..",
    "max_instances": 2,
    "instance_type": "basic"
  }],
  "durable_objects": { "bindings": [{ "name": "AUDIT_FALLBACK", "class_name": "AuditFallbackContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuditFallbackContainer"] }],
  "vars": {
    "AUDIT_PIPELINE_VERSION": "mcac-0.2.0-mcac-probes-0.2.0-mcac-flags-v0-planner1.5.0-p2.1.0-perplexity",
    "AUDIT_ADMISSION_ENABLED": "false",
    "AUDIT_DAILY_LIMIT": "50",
    "GEOCHECK_METHOD": "mcac",
    "GEOCHECK_MCAC_ENGINE": "perplexity"
  }
}
