# GeoCheck environment template.
# Copy to mock-api/.env or the repository root as .env for local development.
# On Render, add these through the Environment page. Never commit real secrets.

# Render provides PORT automatically. Use this only for local development.
PORT=8787
SITE_ORIGIN=https://geocheck.lisheng.cv
LEGACY_HOST=geocheck.tungowo.com

# Primary structured-analysis provider.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_RELEASE=0731
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled

# Web-grounded GEO evidence provider.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_BASE_URL=https://api.perplexity.ai
PERPLEXITY_ENDPOINT=/chat/completions
# Shared request queue interval. 1500 ms keeps starts below 40 requests/minute.
PERPLEXITY_MIN_INTERVAL_MS=1500

# Private cost dashboard.
# ADMIN_PATH_TOKEN must be 16-128 characters from A-Z, a-z, 0-9, _ and -.
ADMIN_PATH_TOKEN=
ADMIN_TOKEN=

# Browser fetching and production rate limits.
DISABLE_BROWSER_FETCH=false
RATE_LIMIT_IP_WINDOW_MS=600000
RATE_LIMIT_IP_MAX=10
RATE_LIMIT_URL_COOLDOWN_MS=1800000
MAX_ACTIVE_AUDITS=2
AUDIT_CACHE_TTL_MS=604800000

# Durable audit-report store. Leave all three blank to keep the process-local
# cache only. Use a dedicated D1 API token with D1 Read and D1 Write only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# Render sits behind a trusted reverse proxy. Keep false for ordinary local use.
TRUST_PROXY=false

# Optional cost estimates in USD per 1,000,000 tokens, or per request.
DEEPSEEK_INPUT_USD_PER_1M_TOKENS=
DEEPSEEK_OUTPUT_USD_PER_1M_TOKENS=
PERPLEXITY_INPUT_USD_PER_1M_TOKENS=
PERPLEXITY_OUTPUT_USD_PER_1M_TOKENS=
PERPLEXITY_USD_PER_REQUEST=

# Optional structured-provider fallbacks. Leave unset for a minimal deployment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Developer API prototype. These values are local-only; the four provider keys
# below are required together when DEVELOPER_API_MODE=official.
DEVELOPER_API_PROTOTYPE_ENABLED=false
DEVELOPER_API_PROTOTYPE_KEY=
DEVELOPER_API_MODE=fixture
# Durable Developer API backend. For local testing, set only LOCAL_DB_PATH.
# For shared environments, leave LOCAL_DB_PATH blank and set the two gateway
# values. The Worker binding, not an account-wide token, selects B's D1.
DEVELOPER_API_PLATFORM_ENABLED=false
DEVELOPER_API_LOCAL_DB_PATH=
GEOCHECK_DEVELOPER_D1_GATEWAY_URL=
GEOCHECK_DEVELOPER_D1_GATEWAY_TOKEN=
# Legacy administrative REST transport; do not combine with gateway values.
GEOCHECK_DEVELOPER_D1_ACCOUNT_ID=
GEOCHECK_DEVELOPER_D1_DATABASE_ID=
GEOCHECK_DEVELOPER_D1_API_TOKEN=
DEVELOPER_API_D1_TIMEOUT_MS=5000
DEVELOPER_API_TOKEN_PEPPER=
# Human-owned policies: production startup fails when these are omitted.
DEVELOPER_API_QUOTA_WINDOW_STRATEGY=
DEVELOPER_API_RESULT_RETENTION_DAYS=
DEVELOPER_API_TRIAL_DAYS=7
DEVELOPER_API_FREE_ROUNDS_PER_WINDOW=3
DEVELOPER_API_DAILY_BUDGET_TWD=
DEVELOPER_API_MONTHLY_BUDGET_TWD=
DEVELOPER_API_MAX_JOB_COST_TWD=
DEVELOPER_API_TWD_PER_USD=
ANTHROPIC_API_KEY=

# Product A Dashboard tracking foundation. Disabled unless all three Dashboard
# values are set. This deliberately does not reuse Developer API credentials.
# DASHBOARD_DATABASE_PATH is a local SQLite path for tests/development only;
# remote Product A D1 migration remains a separately approved operation.
DASHBOARD_API_ENABLED=false
DASHBOARD_DATABASE_PATH=
DASHBOARD_TOKEN_PEPPER=
DASHBOARD_ADMIN_TOKEN=

# Shared Google OAuth app. The client secret is server-only; A and B state
# keys remain distinct. GSC data is impossible to persist without the 32-byte
# base64 encryption key.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DASHBOARD_ORIGIN=https://geocheck.lisheng.cv
DEVELOPER_API_ORIGIN=https://api.geocheck.lisheng.cv
DASHBOARD_GOOGLE_OAUTH_STATE_KEY=
DEVELOPER_GOOGLE_OAUTH_STATE_KEY=
GSC_TOKEN_ENCRYPTION_KEY=
