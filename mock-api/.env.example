# Copy this file to mock-api/.env (or project root .env). Never commit real values.

PORT=8787
SITE_ORIGIN=https://geocheck.lisheng.cv
LEGACY_HOST=geocheck.tungowo.com

# DeepSeek: structured audit interpretation. Confirm /api/test-provider after deployment.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# API model ID is rolling; record the observed provider release for each research run.
DEEPSEEK_MODEL_RELEASE=0731
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Batch research defaults to non-thinking mode so temperature=0 remains effective.
DEEPSEEK_THINKING=disabled

# Single-site structured-analysis fallback order is fixed: DeepSeek -> GPT-5.6 Luna -> Gemini.
# Whitepaper batches intentionally disable fallback so one cohort never silently mixes models.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Perplexity: web-grounded public context.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_BASE_URL=https://api.perplexity.ai
PERPLEXITY_ENDPOINT=/chat/completions

# Private cost dashboard. The bookmark is https://your-domain/<ADMIN_PATH_TOKEN>.
# ADMIN_PATH_TOKEN must be 16-128 characters from A-Z, a-z, 0-9, _ and -.
ADMIN_PATH_TOKEN=
ADMIN_TOKEN=

# Optional cost estimates. Prices are USD per 1,000,000 tokens unless stated otherwise.
DEEPSEEK_INPUT_USD_PER_1M_TOKENS=0.14
DEEPSEEK_OUTPUT_USD_PER_1M_TOKENS=0.28
OPENAI_INPUT_USD_PER_1M_TOKENS=
OPENAI_OUTPUT_USD_PER_1M_TOKENS=
GEMINI_INPUT_USD_PER_1M_TOKENS=
GEMINI_OUTPUT_USD_PER_1M_TOKENS=
PERPLEXITY_INPUT_USD_PER_1M_TOKENS=
PERPLEXITY_OUTPUT_USD_PER_1M_TOKENS=
PERPLEXITY_USD_PER_REQUEST=

# Optional browser fallback for sites that block server-side fetch.
PLAYWRIGHT_NODE_MODULES=
DISABLE_BROWSER_FETCH=false

# Scrapling extends the homepage fallback chain with browser-TLS HTTP and, when
# needed, dynamic/stealth browser fetching. It reuses the Playwright Chromium
# installed by npm; no proxy, credentials, CDP endpoint, or CAPTCHA solver is used.
DISABLE_SCRAPLING_FETCH=false
SCRAPLING_TIMEOUT_MS=45000
# Fail closed for the Scrapling stages if robots.txt cannot be read or forbids
# the GeoCheck-Audit user agent. Do not set false in the public service.
SCRAPLING_RESPECT_ROBOTS=true
# Override only when the Python virtual environment lives outside the project.
SCRAPLING_PYTHON_BIN=

# MVP abuse controls. Replace in-memory limits with shared storage for multi-instance production.
RATE_LIMIT_IP_WINDOW_MS=600000
RATE_LIMIT_IP_MAX=10
RATE_LIMIT_URL_COOLDOWN_MS=1800000
MAX_ACTIVE_AUDITS=2
AUDIT_CACHE_TTL_MS=604800000
TRUST_PROXY=false

# Durable report cache for the Render-hosted Node service. Do not use a
# cross-project database or a global Cloudflare API key.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
