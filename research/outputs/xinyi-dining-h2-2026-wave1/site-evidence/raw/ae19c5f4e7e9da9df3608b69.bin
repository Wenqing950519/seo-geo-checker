  <script>
    (function() {
      var queue = [];
      window.__sentryPreInitQueue = queue;
      function captureToQueue(error) {
        if (window.__sentryPreInitQueue) queue.push(error);
      }
      function onError(event) {
        if (event.error !== null) captureToQueue(event.error);
      }
      function onUnhandledRejection(event) {
        captureToQueue(event.reason !== undefined ? event.reason : event);
      }
      window.addEventListener('error', onError);
      window.addEventListener('unhandledrejection', onUnhandledRejection);
      window.__sentryPreInitListeners = { onError: onError, onUnhandledRejection: onUnhandledRejection };
    })();
  </script>
