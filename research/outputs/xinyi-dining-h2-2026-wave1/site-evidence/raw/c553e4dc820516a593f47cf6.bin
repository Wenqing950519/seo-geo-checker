			//從哪邊 postMessage 過來的，就回傳給哪邊，修正
			event.source.postMessage(callbackurl, event.origin);
		}else{
			//console.log("收到 iframe_ask_href 的request " + JSON.stringify(event.data) + " from " + event.origin);
		}
	}, false);
</script>
