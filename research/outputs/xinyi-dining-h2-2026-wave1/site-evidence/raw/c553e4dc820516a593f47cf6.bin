	let store_branch = 0;
	ui_custom_list = [{"page_element_id":"header-banner","info":"&lt;script&gt;\n\t$(document).ready(function(){\t\n\t\tvar current_url = window.location.href;\t\n\t\tif(current_url.indexOf(&#034;https://www.skm.com.tw/&#034;) &gt;= 0 ){\t\t\t\n\t\t\t// 要初始化的程式寫在裡面\n\t\t\t$(&#034;.p-0.p-b-40.page-header-bn&#034;).owlCarousel({\n\t\t        center: true,\n\t\t        loop: true,\n\t\t        nav: false,\n\t\t        dots: true,\n\t\t        margin: 0,\n\t\t        autoplay:true,\n\t\t        autoplayTimeout:2500,\n\t\t        autoplayHoverPause:true,\n\t\t        responsive: {\n\t\t          0: {\n\t\t            items: 1\n\t\t          },\n\t\t          767: {\n\t\t            items: 2\n\t\t          }\n\t\t        }\n\t\t    });\n\t\t}\n\t});\n&lt;/script&gt;\n&lt;style&gt;\n.margin_top6.page-header-bn {padding:0;background-color: #F5F5F5;}\n.margin_top6.page-header-bn .container {max-width:100%;padding:0;}\n.p-0.p-b-40.page-header-bn {margin:0 auto;position: relative;}\n.p-0.p-b-40.page-header-bn &gt; .owl-stage-outer {padding:55px 0;position: relative;}\n.p-0.p-b-40.page-header-bn &gt; .owl-stage-outer::before,.p-0.p-b-40.page-header-bn &gt; .owl-stage-outer::after {content:&#034;&#034;;display: block;position:absolute;top: 0;height: 100%;width: 28%;z-index: 2;pointer-events: none;}\n.p-0.p-b-40.page-header-bn &gt; .owl-stage-outer::before {background-image: linear-gradient(90deg, #f8f8f8 10%, #f8f8f800 100%);left:0;}\n.p-0.p-b-40.page-header-bn &gt; .owl-stage-outer::after {background-image: linear-gradient(-90deg, #f8f8f8 10%, #f8f8f800 100%);right:0;}\n.p-0.p-b-40.page-header-bn &gt; .owl-stage-outer .owl-stage .owl-item .col-12 .col-12 {display:none;}\n.p-0.p-b-40.page-header-bn &gt; .owl-stage-outer .owl-stage .owl-item .p-b-20.col-12 {width:100%;padding:0;display:block;}\n.p-0.p-b-40.page-header-bn &gt; .owl-stage-outer .owl-stage .owl-item .p-b-20.col-12 .col-12.pos-relative {display:block;}\n.p-0.p-b-40.page-header-bn &gt; .owl-stage-outer .owl-item {transition: transform .2s ease-out;transform: scale(1);z-index: 0;}\n.p-0.p-b-40.page-header-bn &gt; .owl-stage-outer .owl-item.center {transition: transform .2s ease-out;transform: scale(1.07);z-index: 3;box-shadow: rgb(17 17 26 / 24%) 0px 4px 16px, rgb(17 17 26 / 16%) 0px 8px 32px;}\n.p-0.p-b-40.page-header-bn .owl-carousel.owl-loaded {position: relative;}\n.p-0.p-b-40.page-header-bn .owl-theme .owl-nav.disabled+.owl-dots {margin: 0;position: absolute;z-index: 3;left: 15px;top: 50%;transform: translateY(-50%);-webkit-transform: translateY(-50%);display: block;}\n.p-0.p-b-40.page-header-bn .owl-theme .owl-dots .owl-dot {display: block;height: auto;}\n.p-0.p-b-40.page-header-bn .owl-theme .owl-dots .owl-dot span {width: 20px !important;height: 3px !important;transition: transform .2s ease-out;margin: 5px 0px !important;}\n.p-0.p-b-40.page-header-bn .owl-theme .owl-dots .owl-dot.active span, .p-0.p-b-40.page-header-bn .owl-theme .owl-dots .owl-dot:hover span {width:40px !important;transition: transform .2s ease-out;}\n.p-0.p-b-40.page-header-bn.owl-theme .owl-nav.disabled + .owl-dots {position: absolute;left: 2px;top: 50%;transform: translateY(-50%);-webkit-transform: translateY(-50%);text-align: left;width: auto;margin: 0;padding: 0;}\n.p-0.p-b-40.page-header-bn.owl-theme .owl-dots {display: flex;flex-direction: column;}\n.p-0.p-b-40.page-header-bn.owl-theme .owl-dots button {height:auto;}\n.p-0.p-b-40.page-header-bn.owl-theme .owl-dots button span {width:12px !important;height:12px !important;}\n@media (max-width: 767px) {\n.p-0.p-b-40.page-header-bn &gt; .owl-stage-outer::before, .p-0.p-b-40.page-header-bn &gt; .owl-stage-outer::after {background-image: none;}\n.p-0.p-b-40.page-header-bn.owl-theme .owl-dots button span {width: 7px !important;height: 7px !important;}\n.p-0.p-b-40.page-header-bn &gt; .owl-stage-outer {padding: 8px 0;}\n.p-0.p-b-40.page-header-bn &gt; .owl-stage-outer .owl-item {padding:0 13px;}\n}\n&lt;/style&gt;"},{"page_element_id":"div_page_init_wrap","info":"&lt;style&gt;\n.mob-padding {width:1166px;margin:0 auto;padding:15px;}\n.imp-info-area {width:100%;display: flex;flex-direction: row;justify-content: space-between;}\n.imp-info-block {width:31%;padding:20px 0 70px 0;display: flex;flex-direction: column;box-shadow: 3px 3px 12px 3px rgba(0, 0, 0, .1);position: relative;border-radius: 10px;}\n.imp-info-hold {width:85%;margin:0 auto;}\n.imp-info-hold .imp-imgs {width:40%;}\n.imp-info-hold .imp-imgs img {width:100%;}\n.imp-info-hold .imp-info {width:100%;}\n.imp-info-hold .imp-info h3 {margin:0;padding:20px 0 10px 0;font-weight: 900 !important;font-size: 20px !important;line-height: 1.7rem;display: block;}\n.imp-info-hold .imp-info span {display: block;color: #616161;font-size: 15px !important;}\n.imp-info-block .info-block-links {position: absolute;bottom:20px;width:85%;left: 50%;-webkit-transform: translateX(-50%);transform: translateX(-50%);display: flex;flex-direction: row;justify-content: space-between;}\n.imp-info-block .info-block-links a {width:auto;display:block;padding: 8px 12px;text-align: center;color:#FFF;text-decoration: none;outline: none;font-size: 15px !important;font-weight: 700 !important;}\n.imp-info-block:nth-child(1) .info-block-links a {background-color: #4f49b9;}\n.imp-info-block:nth-child(2) .info-block-links a {background-color: #de0817;}\n.imp-info-block:nth-child(3) .info-block-links a {background-color: #0ab53b;}\n@media(max-width:1166px){\n.mob-padding {width:100%;}\n}\n@media(max-width:991px){\n.imp-info-area {flex-direction: column;align-items: center;}\n.imp-info-block {width:70%;margin: 10px 0;}\n}\n@media(max-width:767px){\n.imp-info-hold .imp-imgs {display:none;}\n.imp-info-block {width:100%;padding: 0px 0 80px 0;}\n.imp-info-hold {width:92%;}\n.imp-info-block .info-block-links {width:92%;}\n}\n@media(max-width:499px){\n.imp-info-block {margin:0;box-shadow:none;padding: 0px 0 75px 0;}\n.imp-info-area {width: 100%;box-shadow: 3px 3px 12px 3px rgba(0, 0, 0, .15);margin: 0 auto;padding: 0 20px;}\n.imp-info-hold {width:100%;}\n.imp-info-area .imp-info-block:nth-child(2) {border-top: 1px solid #b8b8b8;border-radius: 0px;border-bottom: 1px solid #b8b8b8;}\n.imp-info-block .info-block-links {bottom:17px;width:100%;}\n.imp-info-block .info-block-links a {border-radius: 4px;}\n.imp-info-block:nth-child(1) .info-block-links a {box-shadow: rgb(244 244 244 / 62%) 2px 2px 2px 0px inset, rgb(45 40 138) 3px 3px 0px;}\n.imp-info-block:nth-child(2) .info-block-links a {box-shadow: rgb(244 244 244 / 62%) 2px 2px 2px 0px inset, rgb(143 2 12) 3px 3px 0px;}\n.imp-info-block:nth-child(3) .info-block-links a {box-shadow: rgb(244 244 244 / 62%) 2px 2px 2px 0px inset, rgb(5 122 40) 3px 3px 0px;}\n.mob-padding {padding: 50px 0 0 0;width: 90%;}\n}\t\n&lt;/style&gt;\n&lt;div class=&#034;mob-padding&#034;&gt;\n\n&lt;div class=&#034;imp-info-area&#034;&gt;\n\n\n&lt;!-- SKM_start--&gt;\n&lt;div class=&#034;imp-info-block&#034;&gt;\n&lt;div class=&#034;imp-info-hold&#034;&gt;\n&lt;div class=&#034;imp-imgs&#034;&gt;&lt;img src=&#034;https://img.skmbuy.com.tw/App_Images/727/Page/2026/1002/d98e14b3-97ec-4788-b3ff-7846498cf7be.png.webp&#034;&gt;&lt;/div&gt;\n&lt;div class=&#034;imp-info&#034;&gt;\n&lt;h3&gt;2026新光三越週年慶開跑！&lt;/h3&gt;\n&lt;span&gt;全台週年慶活動一次掌握，滿仟送仟點、會員優惠、刷卡攻略回饋全開，還有寶可夢周邊等你帶回家！&lt;/span&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n&lt;div class=&#034;info-block-links&#034;&gt;\n  &lt;a target=&#034;_blank&#034; href=&#034;https://www.skm.com.tw/s/LCjYdXF9&#034;&gt;點我看週年慶攻略&lt;/a&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n&lt;!-- SKM_end--&gt;\n\n&lt;!-- EVENT_start--&gt;\n&lt;div class=&#034;imp-info-block&#034;&gt;&lt;a target=&#034;_blank&#034; href=&#034;https://www.skm.com.tw/page/Xmas1209op?utm_source=skmweb&amp;amp;utm_medium=footer&amp;amp;utm_campaign=xmas&#034; 點我領取千元禮金&lt;=&#034;&#034; a=&#034;&#034;&gt;\n&lt;div class=&#034;imp-info-hold&#034;&gt;\n&lt;div class=&#034;imp-imgs&#034;&gt;&lt;img src=&#034;https://img.skmbuy.com.tw/App_Images/727/Page/2026/1002/785fc34f-fad1-4a38-ba14-53c6dd562bcf.png.webp&#034;&gt;&lt;/div&gt;\n&lt;div class=&#034;imp-info&#034;&gt;\n&lt;h3&gt;週年慶寶可夢大量發生中！&lt;/h3&gt;\n&lt;span&gt;寶可夢主題列車、獨家贈品、超萌周邊、見面會及打卡點一次攻略，週年慶一起開啟寶可夢冒險！&lt;/span&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n&lt;/a&gt;&lt;div class=&#034;info-block-links&#034;&gt;\n&lt;a target=&#034;_blank&#034; href=&#034;https://www.skm.com.tw/s/q2DGOq78&#034;&gt;點我看活動詳情&lt;/a&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n&lt;!-- EVENT_end--&gt;\n\n&lt;!-- LINE_start--&gt;\n&lt;div class=&#034;imp-info-block&#034;&gt;\n&lt;div class=&#034;imp-info-hold&#034;&gt;\n&lt;div class=&#034;imp-imgs&#034;&gt;&lt;img src=&#034;https://img.skmbuy.com.tw/App_Images/727/Page/2026/0910/216a97f4-65a5-4dba-b815-7b58fec21123.png.webp&#034;&gt;&lt;/div&gt;\n&lt;div class=&#034;imp-info&#034;&gt;\n&lt;h3&gt; 加入LINE好友輕鬆掌握優惠訊息&lt;/h3&gt;\n&lt;span&gt;最新優惠、會員好康與限定活動即時掌握！不錯過新光三越精彩情報，還有會員專屬驚喜等你發現&lt;/span&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n&lt;div class=&#034;info-block-links&#034;&gt;\n  &lt;a target=&#034;_blank&#034; href=&#034;https://r.botbonnie.com/BclKR&#034;&gt;點我立即加入好友&lt;/a&gt;\n&lt;/div&gt;\n&lt;/div&gt;\n&lt;!-- LINE_end--&gt;\n\n&lt;/div&gt;\n\n&lt;/div&gt;"},{"page_element_id":"insert_here_static_bottom_fashion","info":"&lt;style&gt;\n.margin_top6 h1,.margin_top6 h2,.margin_top6 h3,.margin_top6 h4,.margin_top6 h5,.margin_top6 h6,.margin_top6 h7,.margin_top6 span,.margin_top6 p,.margin_top6 a,.margin_top6 li {font-family: Microsoft JhengHei,sans-serif,&#034;arial&#034; !important;}\n.media-info-area {max-width:670px;margin:0 auto;padding: 25px 0 10px 0;}\n.media-info-area &gt; .media-info-zone {width:100%;display: flex;flex-direction: row;justify-content: space-between;align-items: center;}\n.media-info-zone &gt; .media-info-imgs {width:200px;padding:0 10px 0 0;}\n.media-info-zone &gt; .media-info-imgs &gt; img {width:100%;}\n.media-info-zone &gt; .media-info-block {width:450px;padding:0px;}\n.media-info-block &gt; h5 {display:block;font-size:1.35rem;color:#000;margin:0 0 3px 0;font-w