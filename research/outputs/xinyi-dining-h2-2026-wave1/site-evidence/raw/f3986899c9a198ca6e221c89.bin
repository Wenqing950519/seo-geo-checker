	}

	.sec_img .news_item .item_text_CBTO p:nth-child(2) {
		padding: 0;
		font-size: 1em;
		line-height: 1.5em;
	    color: #54b2b0;
	}

	.sec_img .news_item .item_text_CBTO p:nth-child(3){
		display:none;
		padding-left: 0;
		font-size: 16px;
	}

	.sec_img .news_item .item_text_CBTO p:nth-child(4) {
		padding-left: 0;
		font-size: 12px;
		padding-bottom: .5em;
	}

	.nbanner.sec_img.index_page .item_text_btn{
		font-size: 12px;
	}

	.nbanner.sec_img.index_page .item_text_btn a{
		font-size: 12px;
	    line-height: 1em;
	}

	.page_wed img {
		height: calc(90vw * 9 / 16);
	}

	.topLineMobile .lang{
		overflow-x: auto;
	    overflow-y: hidden;
	    width: 100%;
	    white-space: nowrap;
	}


}

@media screen and (max-width: 767px){
	.txtInLine_grab {
		display: flex;
	    flex-wrap: nowrap;
	}

	.txtInLine_grab div:nth-child(1) {
		min-width: 13em;
	}

	.txtInLine_grab div:nth-child(2) {
		margin-right: 0;
	}

	#expo {
		display:block;
	}

	.sec_img {
		padding-top: 0;
	}

	#alert{
		width: 80%;
