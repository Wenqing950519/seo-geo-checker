	.page_wed_sec {
		margin-top: 0;
	}

	.select .sri_select_mo {
		width: 5.5em;
	}

	.page_wed .wed_txt {
		width: 100%;
	}

	.page_wed_item {
	    width: 100%;
	    margin: 0;
	}

	.cookieContent > p {
	    	padding-right: 0;
		
	}

	.owl-carousel .text_mark {
		height:10px;
	}

	.sec_img .news_item .item_text_CBTO {
		padding: 3%;
