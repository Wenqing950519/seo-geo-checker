<style type="text/css">

#datepicker1, #book_datepicker1 {
    width: 100%;
    max-width: 550px;
}


button.form_button {
	line-height: 1.6;
    font-size: 16px;
    padding: .4em 1.75em;
}
.page_wed_sec {
    margin: 0 auto;
    max-width: none;
    position: relative;
    width: 90%;
}

.title2 {
	line-height: 1.6;
}

.page_wed img {
	width:100%;
	height:300px;
	height: calc(45vw * 9 / 16);
	object-fit: cover;
}

.page_wed .text_page_btn p {
    font-size: 13px;
}

.page_wed {
	margin: 60px auto;
}

.page_wed .wed_txt {
	width: 70%;
	margin: 0 auto;
	text-align: center;
}

.page_wed .title1,
.page_wed .title2 {
	margin: 0 2%;
	margin-bottom: 20px;
	display: block;
	padding-bottom: 0;
	text-align: center;
	
}

.page_wed .wed_content {
	margin: 60px 0;
	margin-top: 20px;
	text-align: center;
}

.page_wed .wed_content > div {
	margin: 0 2%;
}

.page_wed_list {
	display: flex;
    flex-wrap: wrap;
    row-gap: 50px;
    margin-top: 60px;
}

.page_wed_item {
	width: 46%;
	margin: 0 2%;
}

.wed_content .btn_book {
	margin-right: 20px;
}

.owl-item > div {
	line-height: 0;
}

.page_wed .owl-theme .owl-controls {
	position: absolute;
    width: 90%;
    background: #fff;
    bottom: 0;
    margin: 0 5%;
}

.page_wed .owl-theme .owl-pagination {
	border: solid 1px #e0e0e0;
    border-bottom: 0;
    padding-top: 5px;
}

.page_wed_item_txt {
	margin: 0 5%;
    padding: 5%;
    /*border: solid 1px #e0e0e0;*/
    box-shadow: 3px 3px 10px rgba(0, 0, 0, .3);
    border-top: 0;
    text-align: center;
}

.page_wed .text_mark,
.page_wed_note {
	margin: 0 2%;
}

.page_wed_note {
	padding-bottom: 60px;
}

.page_wed .text_mark {
	margin-top: 120px;
	border-top: 3px solid #54b2b0;
}

.wed_img_subtitle {
	font-size: 18px;
	margin: 0 2%;
    margin-bottom: 20px;
    display: block;
    text-align: center;
    line-height: 1.6;
    font-weight: 400;
}

input[disabled],
input:disabled {
    background-color: #e9e9e9;
    color: #6c6c6c;             
    opacity: 1;                 
    cursor: not-allowed;       
}


/*插入search icon*/
/* 1. 移除 Select2 預設的向下箭頭圖標 */
#form_contact .select2-container--default .select2-selection__arrow {
    display: none !important;
}

/* 2. 讓 Select2 容器成為定位參考點，並設定額外邊距 */
#form_contact .select2-container--default .select2-selection--single {
    /* 讓 SVG 能夠在裡面進行絕對定位 */
    position: relative; 
    /* 增加內邊距，為圖標騰出空間 */
    padding-left: 36px !important; 
}

/* 3. 定義插入的 SVG 圖標的樣式 */
#form_contact .select2-icon-search {
    position: absolute;
    /*top: 50%;  垂直居中 */
    left: 8px; /* 距離左邊 8px */
    /*transform: translateY(-50%); 修正垂直偏移 */
    width: 20px;
    height: 20px;
    color: #888; /* 設定圖標顏色為灰色 */
    pointer-events: none; /* 讓點擊能穿透圖標到達後面的輸入框 */
    z-index: 10; /* 確保圖標在最上層 */
}

/* 4. 修正 Select2 搜尋框內的文字位置 */
#form_contact .select2-container--default .select2-selection--single .select2-selection__rendered {
     padding-left: 0 !important; /* 歸零 Select2 預設的 padding */
     line-height: 1.2em;
}

#form_contact .select2-container--default .select2-selection--single {
	border: 0;
    border-bottom: 1px solid #000;
    border-radius: 0;
}

#form_contact .select2-container {
	padding: 7px 0;
	width: 100% !important;
}

#form_contact .select2-container--default .select2-selection--single .select2-selection__rendered {
    color: #54b2b0;
}

/*end*/

.form-group input {
	width: auto;
    display: inline-block;
    vertical-align: text-bottom;
}

.form-group {
	margin-bottom: 1em;
}

.from_end {
	margin-top: 1em;
	margin-bottom: 60px;
}

.sec_form .field.from_end {
	margin-top: 1em;
	margin-bottom: 60px;
}



.field_title {
	margin-top: 1.5em;
}

#form_contact select {
	font-size: 16px;
    font-weight: 200;
    font-family: "Source Sans Pro", 微軟正黑體, "Microsoft JhengHei", "Lucida Grande", "Lucida Sans Unicode", Helvetica, Arial, Verdana, "sans-serif";
}

.event-type {
    margin-bottom: 5px; 
}

#industry-category {
	width: 100%;
    max-width: 396px;
	margin-left: .3em;
}


#event-type {
	width: 100%;
    max-width: 330px;
    margin-left: .3em;
    font-family: "Source Sans Pro", 微軟正黑體, "Microsoft JhengHei", "Lucida Grande", "Lucida Sans Unicode", Helvetica, Arial, Verdana, "sans-serif";
}

.data_in_grab,
.data_out_grab {
	display: block;
	position: relative;
}

.data_in_d,
.data_out_d {
	width: 24px;
    height: 24px;
    position: absolute;
    left: 10px;
    top: 2px;
}

.data_in_d svg,
.data_out_d svg {
	width:24px;
	height24px;
}

.data_in_grab input,
.data_out_grab input {
	width: calc(99% - 42px);
	padding-left: 42px;

	position: relative;
    z-index: 2;
    background: transparent;
}


.booking_area {
	display: none;
}

.sec_form .field.event_title {
	margin-bottom: 1em;
}

.new2c {
	display: flex;
	flex-wrap: wrap;
	gap: 1%;
}

.new3c {
	display: flex;
	flex-wrap: wrap;
	gap: 1%;
}

.new2c div {
	width: 45%;
	flex-grow: 1;
}

.new3c .bgset {
	width: 43%;
	flex-grow: 1;
	padding: .5em 0;
}

.new3c .bgset_m {
	display: flex;
    width: 5%;
    align-items: center;
    justify-content: center;
}

.new2c .col_2:nth-child(even) {
	margin-left: 0;
}




#new_form_grab {
	display:none;
}

#expo {
	display:none;
}

.copyTop {
    padding-top: 10px;
    font-size: 12px;
    color: #888;
}

.cookie {
	width: 100%;
    position: fixed;
    display: none;
    bottom: 0px;
    background: #54b2b0;
    opacity: .9;
    color: #11293b;
    z-index: 9999;
}

.cookieContent{
	margin: 0 auto;
	padding: 3%;
	display: block;
	/*width: auto;*/
	width: fit-content;
}

.cookieContent > p {
	display: inline-block;
	padding-right: 30px;
	font-size: 12px;
}

.cookieContent > .bannerBlock_buttons {
	display: inline-block;
	background: #666;
	color: #fff;
	margin-top: 30px;
	cursor: pointer;
}


.button_iii{
	display:inline-block;
	background: rgba(52, 80, 103, 0);
	border: solid 1px #fff;
	color: #fff;
	padding: 0.5em 2em;
	-webkit-transition: background .5s ease-in-out;
	-moz-transition: background .5s ease-in-out;
	-ms-transition: background .5s ease-in-out;
	-o-transition: background .5s ease-in-out;
	transition: background .5s ease-in-out; 
}
.button_iii:hover{
	background: rgba(255, 255, 255, 0.2);
	color: #fff;
	text-decoration:none;
}

.cookieContent > .bannerBlock_buttons > .button_iii {
	border: 0;
	font-size: 14px;
}

.sec_img .news_item .item_text_CBTO p:nth-child(2),
.sec_img .news_item .item_text_CBTO p:nth-child(3),
.sec_img .news_item .item_text_CBTO p:nth-child(4){
	padding-left: 0;
}

.sec_img .news_item .item_text_CBTO p:nth-child(2) {
    color: #54b2b0;
}


.sec_img {
    margin: 0 auto;
}

#sec_mask_ad {
    position: fixed;
    top: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    background-color: rgba(0, 0, 0, 0.7);
}

#alert{
	position: fixed;
	width:60%;
	z-index: 10000;
	margin: 0 20%;
	top:50%;
	transform: translateY(-50%);
	display:block;
	color: #fff;

}

#alert .container {
	position: relative;
    width: fit-content;
    margin: 0 auto;
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
}


#alert img{
	cursor: pointer;
	text-align: center;
    height: 50%;
    width: auto;
    margin: 0 auto;
    vertical-align: top;
    display: block;
    opacity: 0;
}

#alert a{
color:#fff;
color:#cd8755;

}

#alert_close{
	position:absolute;
    top: 0;
    right: 0;
}

#alert img{
	width: 100%;
}

.close-button {
  width: 50px;
  height: 50px;
  box-shadow: 0px 10 10px 10px rgba(0, 0, 0, 0.25);
  background: #54b2b0;
  position: absolute;
  display: block;
  z-index: 200;
  text-indent: -9999px;
}
.close-button:before,
.close-button:after {
  content: '';
  width: 55%;
  height: 2px;
  background: #fff;
  position: absolute;
  top: 48%;
  left: 22%;
  -webkit-transform: rotate(-45deg);
  -moz-transform: rotate(-45deg);
  -ms-transform: rotate(-45deg);
  -o-transform: rotate(-45deg);
  transform: rotate(-45deg);
  -webkit-transition: all 0.3s ease-out;
  -moz-transition: all 0.3s ease-out;
  -ms-transition: all 0.3s ease-out;
  -o-transition: all 0.3s ease-out;
  transition: all 0.3s ease-out;
}
.close-button:after {
  -webkit-transform: rotate(45deg);
  -moz-transform: rotate(45deg);
  -ms-transform: rotate(45deg);
  -o-transform: rotate(45deg);
  transform: rotate(45deg);
  -webkit-transition: all 0.3s ease-out;
  -moz-transition: all 0.3s ease-out;
  -ms-transition: all 0.3s ease-out;
  -o-transition: all 0.3s ease-out;
  transition: all 0.3s ease-out;
}

#comm_option {
	font-size: 16px;
    font-weight: 200;
    font-family: "Source Sans Pro",微軟正黑體,"Microsoft JhengHei","Lucida Grande","Lucida Sans Unicode",Helvetica,Arial,Verdana,"sans-serif";
    position: relative;
    top: -2px;
    left: 5px;
}

.select .arr {
    top: 9px;
    position: absolute;
    right: -25px;
}

.select .rightSelect {
    min-width: 82px;
}

.select .arr::before { 
	top: 0;
    margin-top: 0;

}

.select .arr::after {
	top: -1px;
    right: 28px;
    margin-top: 0;
    border-top: 4px solid #fff;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;

}

.adln {
	line-height:2;
	vertical-align: text-bottom!important;
}

body.fixed {
	position:fixed;
}

#sec_mask_menu {
	display:none;
    position: fixed;
    top: 0;
    width: 100%;
    height: 100%;
    z-index: 999;
    background-color: rgba(0, 0, 0, 0.7);
}

.cart {
	height: 1em;
	width: auto;
}

header>.subfunc>.lang {
	max-width: calc(100% - 172px);
    overflow-x: auto;
    white-space: nowrap;
}

.sec_arts a:hover {
	text-decoration: none;
}

.need {
	color: #f2655a;
}

.field input {
  border: none;
  border-bottom: 2px solid #ccc;
  outline: none;
  transition: border-color 0.3s;
}

.field.form-error input {
  border-bottom-color: #f2655a !important;
  box-shadow: none;
}

.field.form-error select {
  border: 2px solid #f2655a;
}

@media screen and (max-width: 1400px) {

	.cookieContent > p {
