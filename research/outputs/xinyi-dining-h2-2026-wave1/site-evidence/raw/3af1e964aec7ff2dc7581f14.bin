<script>
var lang=new Object();
lang["eng"]="";
lang["jp"]="";//まもなく日本語のホームページが完成致します
lang["kr"]="";//출시 예정
lang["tw"]="";

var path='';
/*載入訊息檔案*/
var sysMsg=Array();
var mainWebPath="./";
var mainAdmPath="./";
var domain='https://www.dintaifung.com.tw/';
var page='index.php';
$(document).ready(function(){
    $.ajax({
        url: mainWebPath+"js/langs/tw.json",
        type: "GET",
        dataType: "json",
        success: function(Jdata){
            sysMsg=Jdata;
        },
        error: function() {
            alert("Failed To Load Language File.");
        }
    });
   
    $("#language").change(function(){
        var vv=$(this).val();
        var msg=lang[vv];
        if(msg){
            alert(msg);
        }else{
            if(vv==="tw")window.location.href=domain+page; else
            window.location.href=domain+vv+"/"+page;
        }
    });
});
</script>
