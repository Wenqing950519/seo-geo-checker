    <script>
    var k1='';
    var k2='';
    $( document ).ready(function() {
              $('.filter').on('change',function(){
          var k1 = $('#filter_k1').val();
          var k2 = $('#filter_k2').val();
          if(k1=='' && k2==''){
            $('.search--content').show();
          }else{
            if(k1){k1='.'+k1;}
            if(k2){k2='.'+k2;}
            $('.search--content').hide();
            $(k1+k2).show();
          }
        });
          });
    </script>

