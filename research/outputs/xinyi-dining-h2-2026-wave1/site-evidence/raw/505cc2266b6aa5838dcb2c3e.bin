		        <style>
                    @import url("https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@200..900&display=swap");
                </style>
		        <script>
		            jQuery( document ).ready( function( $ ) {
		                const $id   = "Steakhouse-51067",
		                      $ide  = "#Steakhouse-51067",
		                      $el   = $($ide);
		                
		                var fw  = 0,
		                    ep  = $el.offset(),
	                        et  = ep.top,
	                        wW  = $(window).width(),
	                        wH  = $(window).height();
		                $el.find(".content-wrap").each(function(){
		                    fw += $(this).outerWidth();
		                });
		                fw = Math.round(fw);
		                
		                if( wW > 979 ){
		                    $el.find(".img-hover").each(function(){
    		                    var img = "https://www.dannycompany.com.tw/wp-content/plugins/sgi-custom-steakhouse/assets/image/"+$(this).data("pic");
    		                    
    		                    $(this).append("<img class=\"hover-img\" src=\""+img+"\">");
    		                });
                            $el.find(".img-hover").on("mouseenter mouseleave mousemove",function(e){
                                switch( e.type ){
                                    case "mouseenter":
                                        $(this).addClass("start-flow");
                                        $(this).parent().addClass("start-flow");
                                        break;
                                    case "mouseleave":
                                        $(this).removeClass("start-flow");
                                        $(this).parent().removeClass("start-flow");
                                        break;
                                    case "mousemove":
                                        $(this).addClass("start-flow")
                                        
                                        var wW   = $(this).width(),
                                            wH   = $(this).height(),
                                            img  = $(this).find("img.hover-img"),
                                            imgH = img.height(),
                                            imgW = img.width();
                                        
                                        $(this).find("img.hover-img").css({
                                            "top" : (e.offsetY-imgH*2/3)+"px",
                                            "left" : e.offsetX+"px",
                                        })
                                        break;
                                }
                            });
                            $el.find(".chef-title .wrap-inner").on("mouseenter mouseleave mousemove",function(e){
                                switch( e.type ){
                                    case "mouseenter":
                                        $(this).addClass("start-flow");
                                        break;
                                    case "mouseleave":
                                        $(this).removeClass("start-flow");
                                        break;
                                    case "mousemove":
                                        $(this).addClass("start-flow")
                                        
                                        var offset = $(this).offset();
                                        var relativeX = e.pageX - offset.left;
                                        var relativeY = e.pageY - offset.top;
                        
                                        $(this).find(".m-cursor").css({
                                            "top": (relativeY - 50) + "px",
                                            "left": (relativeX - 50) + "px",
                                        });
                                        break;
                                }
                            });
                            
                            
		                }
		                
		                var fh      = wW > 979 ? fw+wH : fw+wH,
		                    eb      = et+fw,
		                    ct1     = $el.find(".chef-banner").width(),
		                    ct1e    = ct1/2,
		                    ct2l    = $el.find(".chef-title").width()/4,
		                    ct2     = ct1 + ct2l
		                    ct3l    = ct1 + ct2l*3,
		                    ct3t    = $el.find(".chef-introduce .introduce-str"),
		                    ct3tt   = ct3t.text(),
		                    ct3ti   = 0,
		                    end = wW > 979 ? Math.round(eb-wW+30) : Math.round(eb-wW+10),
		                    isEnd = 0;
		                
		                ct3t.css({
		                    "height" : ct3t.height()+"px",
		                    "width" : ct3t.width()+"px"
		                }).text("");
		                $el.css({
		                    "height"    : fh+"px",
		                });
		                $el.find(".fixed-screen").css("width",fw+"px").addClass("ready-to-scroll");
		                
		                $(window).trigger("scroll");
		                $(window).scroll(function(){
		                    var tp  = $(window).scrollTop(),
		                        tb  = tp+$(window).height(),
		                        now = 0,
		                        $screen = $el.find(".fixed-screen"),
		                        sp  = $screen.offset(),
		                        sl  = Math.abs(sp.left);
		                    
		                    ep  = $el.offset();
	                        et  = ep.top;
		                    $screen.removeClass("scroll-start scroll-end");
		                    $el.find(".start-flow").removeClass("start-flow");
		                    
		                    var bannerMove = 0,
		                        bannerTrans= "";
		                    if( sl > 0 ){
		                        bannerMove = 1 - (ct1e - sl)/ct1e;
		                        bannerMove = bannerMove >= 1 ? 1 : bannerMove;
		                        
		                        bannerTrans = "rotateY("+bannerMove*20+"deg) scale("+( 1.1 + (1-bannerMove)*0.1 )+")";
		                    }
		                    $el.find(".chef-banner img").css({
		                       "transform" :  bannerTrans
		                    });
		                    
		                    var titleBGtrans = 0;
		                    if( sl > ct2 ){
		                        titleBGtrans = (sl - ct2)/ct2l*100/5;
		                        titleBGtrans = titleBGtrans > 100 ? 100 : titleBGtrans;
		                    }
		                    $el.find(".chef-title .bg-trans").css({
		                       "left" :  "-"+titleBGtrans+"%"
		                    });
		                    
		                    if( sl > ct3l ){
		                         if( !ct3t.parent().hasClass("text-in") ){
		                            ct3ti = 0;
		                            typeWriter( ct3t , ct3tt , ct3ti );   
		                         }
		                         ct3t.parent().addClass("text-in");
		                    }else{
		                        if( ct3t.parent().hasClass("text-end") ){
    		                        ct3t.text("");
    		                        ct3t.parent().removeClass("text-in text-end");
		                        }
		                    }
		                    
		                    var screenTop = 0,
		                        endLine   = fw-wW+30;
		                    if( tp >= et ){
		                        $screen.addClass("scroll-start");
		                        
		                        now = tp-et;
		                        now = now > endLine ? endLine : now;
		                    }
		                    
		                    
		                    if( tp >= end ){
		                        now = endLine;
		                        
		                        if( tb > et+fh ){
		                            screenTop = tp-et;
		                            screenTop = screenTop > fh-$screen.height() ? fh-$screen.height() : screenTop;
		                            $screen.addClass("scroll-end");
		                        }
		                    }
		                    
		                    $screen.css({
		                        "transform" : "translateX(-"+now+"px)",
		                        "top" : screenTop+"px"
		                    });
		                });
		                
		                function typeWriter( $tar , $text , $i , $speed = 35 ) {
                            if ($i < $text.length) {
                                $tar.append($text.charAt($i)); 
                                $i++;
                                setTimeout(function(){
                                    typeWriter( $tar , $text , $i , $speed )
                                },$speed); 
                            }else{
                                $tar.parent().addClass("text-end");
                            }
                        }
		            })
		        </script>
		    </div>
	</div>
</div>
	</div>
</div>
	</div>
		</div>
	</div>
</div>
</div>											</div>

					
