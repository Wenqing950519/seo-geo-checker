<style>
    .brand-content-slider button.slick-arrow{ display:none; }
    .brand-content-slider .slick-slider{ width: 120vw; transform: translateX(-10vw); }
    .brand-content-slider .slick-slide{ padding: 0 5vw; }
    .brand-content-slider .slick-slide .brand-slide{ transform: scale(0.85); transition: .3s; }
    .brand-content-slider .slick-slide .brand-slide .brand-slide-content-wrap{ transform: translateY(-40px); opacity: 0; transition: .3s; }
    .brand-content-slider .slick-slide.slick-center .brand-slide{ transform: scale(1); }
    .brand-content-slider .slick-slide.slick-center .brand-slide .brand-slide-content-wrap{ transform: translateY(0); opacity: 1; transition: .6s; }
    
    .brand-content-slider .brand-slide-photo-img{ width: 100%; height: auto; object-fit: cover; object-position: center; }
    .brand-content-slider .brand-slide-title{ font-family: Poppins; font-size: 20px; font-weight: 500; line-height: 1.5; text-align: left; color: #000; margin-bottom: 15px; margin-top: 40px; }
    .brand-content-slider .brand-slide-text *{ font-family: "Noto Serif TC", serif; font-size: 15px; line-height: 1.73; text-align: left; color: #000; }
    
    .brand-content-slider .slick-dots{ display: flex!important; justify-content: center; flex-direction: row; transform: translateX(20px); }
    .brand-content-slider .slick-dots li{ margin: 0 10px; cursor: pointer; }
    .brand-content-slider .slick-dots li::marker{ color: #999; font-size: 30px; }
    .brand-content-slider .slick-dots li.slick-active::marker{ color: #202020; }
    .brand-content-slider .slick-dots button{ display:none; }
    
    .brand-content-slider{ position: relative; }
    .brand-content-slider .nav-btn.first{ opacity: 1; top: 0; right: 10%; transform: translateY(-50%); }
    .brand-content-slider .nav-btn{ font-size: 20px; border-radius: 50%; width: 1em; height: 1em; display: inline-flex; position: absolute; color: #fff; background-color: #000; cursor: none; opacity: 0; pointer-events: none;
        padding: 50px; align-items: center; justify-content: center; z-index: 9;  }
    .brand-content-slider .nav-btn.start-flow{ opacity: 1; pointer-events: auto; transition: opacity .6s; }
    .brand-content-slider .nav-btn.left{ transform: rotate(180deg); }
    
    @media(max-width:979px){
        .brand-content-slider .nav-btn.first{ opacity:0; }
        .brand-content-slider .slick-slide{ padding: 0 20px; }
        .brand-content-slider .slick-slider { width: 160vw; transform: translateX(-30vw); }
    }
    @media(max-width:767px){
        .brand-content-slider .slick-slide{ padding: 0 10px; }
        .brand-content-slider .slick-slider { width: 220vw; transform: translateX(-60vw); }
        
        .brand-content-slider .brand-slide-title{ font-size: 18px; margin-bottom: 10px; margin-top: 20px; }
        .brand-content-slider .brand-slide-text *{ font-size: 13px; }
    }
</style>
<script>
    jQuery( document ).ready( function( $ ) {
    	    const $id   = 'slider-3045494',
    	          $ide  = $('#'+$id);
    	    
    	    document.addEventListener('keydown', function(event) {
              if (event.key === 'ArrowRight') {
                $ide.find('button.slick-next').trigger('click');
              } else if (event.key === 'ArrowLeft') {
                $ide.find('button.slick-prev').trigger('click');
              }
            });
            
            var eW  = $ide.width(),
                sW  = 0,
                fnv = $ide.find('.nav-btn');
            $(window).scroll(function(){
                fnv.removeClass("start-flow");
                fnv.parent().removeClass("start-flow");
            })
            
            if( $(window).width() > 979 ){
                fnv.click(function(){
                    if( $(this).hasClass('left') ){
                        $ide.find('button.slick-prev').trigger('click');
                    }else{
                        $ide.find('button.slick-next').trigger('click');
                    }
                });
                
                $ide.on("mouseenter mouseleave mousemove",function(e){
                    sW  = $ide.find('.slick-center.slick-current').width();
                    fnv.removeClass('first');
                    switch( e.type ){
                        case "mouseenter":
                            fnv.addClass("start-flow");
                            fnv.parent().addClass("start-flow");
                            break;
                        case "mouseleave":
                            fnv.removeClass("start-flow");
                            fnv.parent().removeClass("start-flow");
                            break;
                        case "mousemove":
                            fnv.addClass("start-flow");
                            fnv.parent().addClass("start-flow");
                            
                            var offset = $(this).offset();
                            var relativeX = e.pageX - offset.left;
                            var relativeY = e.pageY - offset.top;
                            var where = relativeX >= eW/2 ? 'right':'left';
                            var gap = 40;
                                                        
                            if( relativeX > (eW-sW)/2-gap && relativeX < (eW-sW)/2+sW+gap ){
                                fnv.removeClass("start-flow");
                                fnv.parent().removeClass("start-flow");
                                return false;
                            }
                            
                            fnv.css({
                                "top" : (relativeY-50)+"px",
                                "left" : (relativeX-50)+"px",
                            }).removeClass('right left').addClass(where)
                            break;
                    }
                });
            }
    	    $ide.find('.brand-content-slider-list').slick({
              centerMode: true,
              centerPadding: '0px',
              slidesToShow: 3,
              dots: true,
              autoplay: true,
              draggable: false,
              responsive: [
                {
                  breakpoint: 979,
                  settings: {
                    dots: true,
                    autoplay: true,
                    draggable: true,
                  }
                }
              ]
            });
    	    
    });
</script>
