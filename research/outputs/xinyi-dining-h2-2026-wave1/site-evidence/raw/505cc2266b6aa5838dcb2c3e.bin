<script>
    jQuery( document ).ready( function( $ ) {
	    const $id   = 'brand-items-banner-slider-1981468',
	          $ide  = $('#'+$id);
	    
	    
	    var fw,wOf,wH,sw,vh,wT;
	    
	    
	    setTimeout(function(){
	        settings();
	    },500);
	    
	    if( $(window).width() > 767 ) $(window).on('resize',settings);
	    
	    $(window).scroll(function(){
	        var top = $(window).scrollTop();
	        wOf = $ide.offset();
	        wH  = $ide.height();
	        vh  = $(window).height()/100;
	        wT  = wOf.top;
	        
	        if( !$ide.find(".brand-slider-banner-list").hasClass('slider-ready') ) settings();
	        
	        if( top+3*vh >= wT && top <= ( wT+wH ) ){
	           // $("header.whb-header").hide();
	            $("header.whb-header").addClass("scroll-in-brand-slider");
	        }else{
	           // $("header.whb-header").show();
	            $("header.whb-header").removeClass("scroll-in-brand-slider");
	        }
	    })
	    
	    var slc = $ide.find(".brand-slide").length,loop;
	    var startloop   = function(){
    	    loop    = setInterval(function(){
    	        var autoTo = os+1;
    	        
    	        autoTo = autoTo+1 > slc ? 0 : autoTo;
    	        slide( autoTo );
    	    },6000)
	    };
	    startloop();
	    $ide.find("a.brand-nav").click(function(){
	        slide( $(this).data('key') );
	        
	        clearInterval(loop);
            startloop();
	    })
	    
	    var os = parseInt( $ide.find('.is-active.brand-slide').data('key') );
	    function settings(){
	        fw  = 0;
	        wOf = $ide.offset();
	        wH  = $ide.height();
	        sw  = $(window).width();
	        vh  = $(window).height()/100;
	        wT  = wOf.top;
	        
	        $ide.find(".brand-slide").each(function(){
    	        fw += sw;
    	        
    	        var biH = $(this).find('.slide-inner').height(),
    	            bP  = $(this).find('.brand-banner').position(),
    	            bPL = bP.left , bPT = bP.top , obT = $(this).find('.brand-banner-title:not(.title-over-pic)');
    	        
    	        $(this).find('.title-over-pic').css({
    	           'margin-left': -bPL+"px",
    	           'margin-top' : -bPT+"px",
    	           'width'      : obT.width()+'px',
    	           'height'     : obT.height()+'px'
    	        });
    	        $(this).find('.brand-banner-title').css({
    	           'top'    : (biH/2-obT.height()/2)+"px",
    	        });
    	    })
    	    $ide.find(".brand-slider-banner-list").css("width",fw+"px").addClass("slider-ready");
    	    slide(0);
	    }
	    function slide( slideTo = 0 ){
	        var ns  = parseInt( slideTo ),
	            mv  = os-ns;
	        
	        $ide.find('.brand-slider-banner-list').animate({
	            'left'  : -sw*ns+'px'
	        }, 1000 );
	        $ide.find('.is-active').removeClass('is-active s-rtl s-ltr');
	        $ide.find('[data-key="'+ns+'"]').addClass('is-active');
	        $ide.find('.brand-slide.is-active').addClass(( mv > 0 ? 's-rtl' : 's-ltr' ));
	        
	        os = parseInt( $ide.find('.is-active.brand-slide').data('key') );
	    }
    });
</script>	</div>
</div>
	</div>
</div>
