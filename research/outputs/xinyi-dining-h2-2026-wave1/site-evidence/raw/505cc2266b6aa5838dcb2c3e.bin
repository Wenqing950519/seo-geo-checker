		            #sgi-preload{ position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; overflow: hidden; background-color: #E3E0DA; z-index: 999999; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; transition: 1s; }
		            #sgi-preload .pre-img{ position: relative; z-index: 5; width: 400px; }
		            #sgi-preload .overlay{ position: absolute; background-color: #592F14; width: 450px; height: 450px; border-radius: 50%; transition: 1s; top: 50%; left: 50%; transform: translate(-50%, -50%); }
		            #sgi-preload.loading .overlay{ transform: translate(-50%, -50%) scale(6); }
		            #sgi-preload.loaded{ top: -100%; pointer-events: none; }
		            
		            @media(max-width:767px){
		                #sgi-preload .pre-img{ width: 180px; }
		                #sgi-preload .overlay{ width: 250px; height: 250px; }
		                #sgi-preload.loaded{ top: -150%; pointer-events: none; }
		            }
		        </style>
