    <script src="https://www.inparadise.com.tw/js/wow.min.js"></script>
    <script src="https://www.inparadise.com.tw/js/contact-form.js"></script>
    <script src="https://www.inparadise.com.tw/js/jquery.sticky.js"></script>

    <!--===== ACTIVE JS=====-->
    <script src="https://www.inparadise.com.tw/js/main.js?ver=2025090201"></script>
    

    <script>
        $(function(){
            //videoAutoplay();
            //首頁POP視窗
            $('#eatModal').modal();
            $(window).click(function (e) { 
                videoAutoplay();
            }); 

            background_img_set();
            $(window).resize(function () { 
                background_img_set();
            });
        });
        function videoAutoplay () 
        {  
            //20191111 Tina Chrome autoplay fix
            if($('#home_video').length > 0)
            {
                var promise = $('#home_video').get(0).play();
                if (promise !== undefined) {
                    promise.then(_ => {
                        // Autoplay started!
                        document.getElementById('home_video').muted = false; 
                    }).catch(error => {
                        // Autoplay was prevented.
                        // Show a "Play" button so that user can start playback.
                        console.log('Show a "Play" button so that user can start playback.');
                    });
                }
            }
        }
        function background_img_set()
        {
            $(".background_bg").each(function() {
                var attr = $(this).attr('data-mobile-img-src');
                if (typeof attr !== typeof undefined && attr !== false) 
                {
                    var w = $(window).width();
                    if(w < 768)
                    {
                        $(this).css('background-image', 'url(' + attr + ')');
                    }
                    else
                    {
                        attr = $(this).attr('data-img-src');
                        $(this).css('background-image', 'url(' + attr + ')');
                    }
                }
                else
                {
                    var attr = $(this).attr('data-img-src');
                    if (typeof attr !== typeof undefined && attr !== false) 
                    {
                        $(this).css('background-image', 'url(' + attr + ')');
                    }
                }
            });
        }
    </script>
    </body>
</html>