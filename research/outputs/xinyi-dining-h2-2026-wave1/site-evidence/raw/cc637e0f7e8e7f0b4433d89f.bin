/f749c4386b0be19c3d227455ed4e33931e0fb875.png","event_time":" ~ ","release_date":"2026-08-26","branches":"微風廣場"}]},"edm":[{"id":118,"title":"微風信義X微風松高X微風南山【週年慶】EDM","event_time":"2026-09-29 16:00:00 ~ 2026-11-02 00:00:00","img":"https://breeze-assets.breeze.com.tw/navigation/d442f1f2f5c4a5a888fd43539a9b066d847b2ea3.png","link":"https://books.breezecenter.com/books/rcdm/?open_out"},{"id":119,"title":"微風集團【狂歡夜幕萬聖節】EDM","event_time":"2026-10-09 00:00:43 ~ 2026-11-01 00:00:46","img":"https://breeze-assets.breeze.com.tw/navigation/f52062966221d82f47a1776a3ae05d8eeca073bc.png","link":"https://books.breezecenter.com/books/rlyb/?open_out"},{"id":117,"title":"微風東岸【狂歡夜幕萬聖節】EDM","event_time":"2026-10-09 00:00:00 ~ 2026-11-01 00:00:00","img":"https://breeze-assets.breeze.com.tw/navigation/37dc54048a32c009e0eeb8546df5d88004c06ce4.png","link":"https://books.breezecenter.com/books/eqon/?open_out"},{"id":103,"title":"微風【GOURMET GUIDE 美食導覽手冊】","event_time":"2026-05-08 00:00:00 ~ ","img":"https://breeze-assets.breeze.com.tw/navigation/3e6333be53018d68e15eaecb77e405d79f6862c0.png","link":"https://books.breezecenter.com/books/kvzu/?open_out"}],"branches":[{"branch_id":"001","branch_name":"微風廣場","branch_en":"Breeze Center","branch_image":"https://breeze-assets.breeze.com.tw/branch/cf9314e25b57942418cced5a8b55b4ba18bfae74.jpg?1755306799"},{"branch_id":"009","branch_name":"微風信義","branch_en":"Breeze Xin Yi","branch_image":"https://breeze-assets.breeze.com.tw/branch/4bc3299baeead89c6180b8de2e83300662c49063.jpg?1755308487"},{"branch_id":"012","branch_name":"微風南山","branch_en":"Breeze Nan Shan","branch_image":"https://breeze-assets.breeze.com.tw/branch/9d4948b41c9d6ba9033a0474c91d1b10b95623a7.jpg?1755308905"},{"branch_id":"007","branch_name":"微風松高","branch_en":"Breeze Song Gao","branch_image":"https://breeze-assets.breeze.com.tw/branch/1f272d60c0bd977b4152a0b14967c8de0ee2d09e.jpg?1755308211"},{"branch_id":"005","branch_name":"微風南京","branch_en":"Breeze Nan Jing","branch_image":"https://breeze-assets.breeze.com.tw/branch/46455770efd100c2478b6e77162c352afb364d4c.jpg?1755307707"},{"branch_id":"014","branch_name":"微風東岸","branch_en":"EAST COAST by BREEZE","branch_image":"https://breeze-assets.breeze.com.tw/branch/9359bec2e8d101bae7ce085839f510bef666a049.jpg?1755309184"},{"branch_id":"006","branch_name":"微風台大醫院商場","branch_en":"Breeze NTU Hospital","branch_image":"https://breeze-assets.breeze.com.tw/branch/2aa43da5c8486ea8562a9e336f40ecf7335a531d.jpg?1755307845"},{"branch_id":"011","branch_name":"Trine \u0026 Zen (微風中研院店)","branch_en":"Breeze Academia Sinica","branch_image":"https://breeze-assets.breeze.com.tw/branch/5e227066b8d6a288f44c86b7a838cc44fabcc8ec.jpg?1755310306"},{"branch_id":"000","branch_name":"We‘re still growing...!","branch_en":"","branch_image":"https://breeze-assets.breeze.com.tw/branch/coming_soon.png"}],"category_ads":[{"id":1,"name":"高空主題餐廳","title":"高空主題餐廳","banners":[{"ad_type":"image","banner_app":"https://breeze-assets.breeze.com.tw/navigation/ae72b5e031e96bb5f5d239265e25d691a4fa3707.png","banner_website":"https://breeze-assets.breeze.com.tw/navigation/ea12a53885816922666c23bd695904fd3650ef5f.png","link_id":0}],"shops":[{"branch_name":"微風信義","id":1544,"shop_id":"40180","shop_name":"INPARADISE 饗饗","description":"\u003cp\u003e焠鍊各國料理精髓，詮釋特選食材新樣貌，饗饗不僅為饗宴帶來新視野，更為饗食打造新境界。堅持以鮮緻玩味，觸動旅途上的你，讓回味無窮的心意百匯，感動心中最珍視的人，在每一個珍貴時刻，一起饗饗。\u003c/p\u003e","image":"https://breeze-assets.breeze.com.tw/navigation/f2656817b9624131f8227aedf0b0aa0bd18c90a3.png","image_app":"https://breeze-assets.breeze.com.tw/navigation/efbc55313f240cbda916f9409907e38ff52c9695.png","floor":"46F"},{"branch_name":"微風信義","id":709,"shop_id":"40160","shop_name":"Morton's The Steakhouse","description":"\u003cp\u003e莫爾頓牛排館以享譽全球的頂級美國熟成榖飼牛肉及來自世界各地的美酒佳釀，讓賓客們享受到原汁原味的美式頂級饗宴。位於微風信義45樓，直眺台北101的絕佳景色，讓莫爾頓牛排館成為台北最高且最具標誌性的牛排餐廳。\u003c/p\u003e","image":"https://breeze-assets.breeze.com.tw/navigation/d772fd9ba442d14fbb8ec365cdceb35e4730423a.png","image_app":"https://breeze-assets.breeze.com.tw/navigation/0ffe9cf4245eb979a5e2dbd48dab24f552b2fe68.png","floor":"45F"},{"branch_name":"微風信義","id":5914,"shop_id":"40430","shop_name":"SEA TO SKY","description":"\u003cp\u003eS\u0026amp;W Taipei集團旗下品牌\u0026rdquo;SEA TO SKY - Seafood \u0026amp; Bar\u0026rdquo;位於微風信義百貨47樓，為信義區最新高空海鮮餐廳，\u003c/p\u003e\r\n\r\n\u003cp\u003e以奢華浪漫與時尚愜意的風格廣受喜愛，更成為節日聚餐及約會的首選勝地。\u003c/p\u003e\r\n\r\n\u003cp\u003e以橫跨時空軸線的當代料理作為品牌主軸，輕鬆貼心的服務，令人驚豔的絕佳景色，塑造SEA TO SKY獨一無二的用餐氛圍！\u003c/p\u003e\r\n\r\n\u003cp\u003e品牌將「高空美景」與「遼闊海洋意象」完美結合，整體設計以「海天一線」的概念貫穿其中，清爽而柔和的藍色為品牌核心，\u003c/p\u003e\r\n\r\n\u003cp\u003e高空景觀的天際色彩與餐廳內的漸層藍色裝潢佈置相互映襯 ，彷彿置身天空或海洋邊際的奇幻氛圍，\u003c/p\u003e\r\n\r\n\u003cp\u003e讓用餐客人充分感受著\u0026rdquo;Sea to Sky,Sea to Table\u0026rdquo;海洋直達天際的美食旅程。\u003c/p\u003e\r\n\r\n\u003cp\u003e\u003cstrong\u003e百貨電梯 : 須至微風信義4F，轉乘往47F高樓層電梯\u003c/strong\u003e\u003c/p\u003e\r\n\r\n\u003cp\u003e(週日~周三 : 11:30~21:30；週四~週六 : 11:30~22:00)\u003c/p\u003e\r\n\r\n\u003cp\u003e\u003cstrong\u003e直達電梯 :\u003c/strong\u003e\u003c/p\u003e\r\n\r\n\u003cp\u003e位於「國泰置地廣場大樓1樓櫃台」\u003c/p\u003e\r\n\r\n\u003cp\u003e週一~週三 18:30~21:30, 週四、週五18:30~22:00, 週六11:30~22:00, 週日11:30~21:30\u003c/p\u003e\r\n\r\n\u003cp\u003e若於微風百貨打烊時段後至酒吧消費，煩請撥打02-2758-1116，餐廳將派專人至1樓櫃台接待。\u003c/p\u003e","image":"https://breeze-assets.breeze.com.tw/navigation/374fdd98c4a4b4fd9dd4ee6e04f40e21ac988e38.png","image_app":"https://breeze-assets.breeze.com.tw/navigation/8341da467ed2396c9c189044c559a685932aceba.png","floor":"47F"},{"branch_name":"微風南山","id":7117,"shop_id":"75070","shop_name":"川雅 Chuan Ya","description":"\u003cp\u003e米其林一星川菜餐廳。\u003c/p\u003e\r\n\r\n\u003cp\u003e坐落於台北微風南山星空塔\u0026nbsp;46\u0026nbsp;樓，坐看台北\u0026nbsp;101\u0026nbsp;景觀地標與城市天際，整體空間以橘、米、灰色調深淺交錯拼湊而成，溫潤雅致、逸品風雅。\u003c/p\u003e\r\n\r\n\u003cp\u003e川雅之名為傳統與優雅的結合，其傳統源自於川菜百年歷史文化的深厚堆疊，是從官府菜到家常菜的融合；其優雅則體現在精緻典雅的擺盤美學和細膩豐富的味覺體驗，呼應品牌哲學「優雅川菜」。\u003c/p\u003e\r\n\r\n\u003cp\u003e作為一家專注於「精緻官府川菜」的中餐廳，川雅是對川菜的當代詮釋\u0026mdash;\u0026mdash;承襲松雲派川菜之經典，將四川真味落地台灣餐桌，重新定義川菜在台灣的地位，希望能讓更多人品嘗到川菜二十四味的多層次美學，呈現一菜一格，百菜百味的川菜宴席。\u003c/p\u003e","image":"https://breeze-assets.breeze.com.tw/navigation/7a5b506e0d0657258b1c479adb5b5e325ef8399d.png","image_app":"https://breeze-assets.breeze.com.tw/navigation/803b74bed9e82cde74f5706f08bba1928e72ffeb.png","floor":"46F"},{"branch_name":"微風南山","id":2481,"shop_id":"75060","shop_name":"CÉ LA VI","description":"\u003cp\u003eC\u0026Eacute; LA VI於新加坡、香港、上海、日本與杜拜皆設置於指標性的地段與地點，而台灣首店則位在台北微風南山48F標誌性的屋頂位置，擁有令人驚嘆的360度全景，將全台北映入眼景C\u0026Eacute; LA VI主打現代亞洲烹飪風格，以異國情調的在地食材與風味餐點，搭配創新的雞尾酒及亞洲宜人氣候，由白天到夜晚一路享受頂級的生活。\u003c/p\u003e","image":"https://breeze-assets.breeze.com.tw/navigation/68d1b1a5b8d4f3204ac5922509f4fcdb9d5777bb.png","image_app":"https://breeze-assets.breeze.com.tw/navigation/b5afe0653d841df755a0bfc7ba1fc6ebdde8b067.png","floor":"48F"},{"branch_name":"微風南山","id":2454,"shop_id":"75030","shop_name":"和牛47","description":"\u003cp\u003e「和牛47-和牛燒肉懷石」標榜「日本頂級和牛 Fine Dining」，嚴選世界頂級食材，融合燒肉 + 和牛壽司 + 懷石三大料理主軸， 以四季為名、季節入菜，以「台北新名物」作為華麗開場、御造、一口椀、兩道燒肉、牛排、鍋物、食事到甘味，共9 道精緻料理， 隨著春夏秋冬給賓客不同的驚艷。\u003c/p\u003e\r\n\r\n\u003cp\u003e全程提供專人定烤式服務，打造一處「與特別人在特別的日子享用一流和牛」的美味空間。 座落於時尚美食重鎮的微風南山 47 樓，標高 180 公尺，為 全台景觀最高的燒肉懷石餐廳。面對台北著名地標 101、擁 有絕佳的景觀視野，挑高 5 尺的玻璃帷幕設計，感受與台北 101 相鄰而席、居高臨下的視覺震撼，白天沐浴在陽光下、 俯瞰著摩天大樓林立的城市美景，至夕陽緩緩落下的浪漫美 景，夜幕低垂時更將信義區夜景一覽無遺。\u003c/p\u003e\r\n\r\n\u003cp\u003e到和牛 47 必嚐的明星商品「 台北新名物 - A5 和 牛 PRUNIER 魚子醬手卷＆BALIK 頂級煙燻鮭魚」，特別與 「CAVIAR HOUSE PRUNIER法國百年頂級魚子醬品牌」 聯手打造魚子醬三嚐的奢華名物；斥資百萬打造生牛肉專門 處理室，由料理人在低於 18 度嚴格溫控下每日新鮮現切安 心至上的生牛肉料理，也是許多饕客喜愛品嚐 A5 日本和牛 的方式；高達 47 款不同的「食事」米飯料理，每週推陳出新， 像是櫻花蝦炊飯、鴨肝炊飯等，等著賓客來發掘、感受四季 變化。\u003c/p\u003e\r\n\r\n\u003cp\u003e日本禁止肉食之詔約有千年歷史，一直到大正時期，西洋文 化傳入改變了生活文化飲食習慣，而日本人開始吃牛肉的意 識也在此時開始萌芽，和牛 47 呼應大正時期「和洋兼容」 的文化脈絡。\u003c/p\u003e\r\n\r\n\u003cp\u003e空間隨處可見西洋和日式兩種特色的現代版的日西合壁，以大面黑鏡牆面呈現日本「和」的印象，搭配重 新編織的金屬感竹柵欄，以西洋式燈具貫穿整體空間，交織 出「大正浪漫」風格，作為燒肉飲食的嶄新時代起點。\u003c/p\u003e","image":"https://breeze-assets.breeze.com.tw/navigation/7bf107e36d94a4c634f83d17eb739f51045ac060.png","image_app":"https://breeze-assets.breeze.com.tw/navigation/727f8c9061ab1a3f7f55038d1b2bafaec38f2d0c.png","floor":"47F"},{"branch_name":"微風南山","id":2452,"shop_id":"75010","shop_name":"THE UKAI TAIPEI","description":"\u003cp\u003e來自日本東京的 UKAI 餐飲集團，創業至今已超過半世紀，由御盟集團引進台灣，在微風南山 46 樓坐擁高空壯麗景緻，以星空宇宙為設計主題，帶來了一幕幕精彩絕倫的料理饗宴，除了廣受喜愛的「Ukai-Tei」 鐵板燒外，更帶入「Kappou Ukai」日式割烹，秉持著「款待之心」傳遞幸福美味。\u003c/p\u003e","image":"https://breeze-assets.breeze.com.tw/navigation/5894e0d5085a557a2904fa3d94dc668cd0ed5ff0.png","image_app":"https://breeze-assets.breeze.com.tw/navigation/ba1fab73b4a4094b878372bc1af4cc735980fa6e.png","floor":"46F"},{"branch_name":"微風南山","id":2455,"shop_id":"75050","shop_name":"Smith \u0026 Wollensky","description":"\u003cp\u003e美國最受歡迎的經典牛排餐廳，提供顧客最頂級的乾式熟成牛排與各式優質海鮮，位於微風南山 47 樓，台北 101 與信義區美景盡收眼底。除了賓至如歸的服務，頂級的酒藏飲品與夜間酒吧的 Jazz band 表演，都將帶給您最難忘的體驗。\u003c/p\u003e","image":"https://breeze-assets.breeze.com.tw/navigation/9a4630241416237cd4a28d1a0c506c82d0891b57.png","image_app":"https://breeze-assets.breeze.com.tw/navigation/719a93f08ca6d41c9d9a41e0cbbdc52257e4aa74.png","floor":"47F"},{"branch_name":"微風南山","id":2453,"shop_id":"75020","shop_name":"SAFFRON 46","description":"\u003cp\u003e以最珍貴的香料番紅花為名，將印度千變萬化的香料與不同地區的道地風味結合，番紅花一直是台北印度料理餐廳中最響亮的名字。2018 底這朵深受饕客喜愛的番紅花，從天母進軍信義區正式邁向嶄新里程，摩登細緻的全新空間設有酒吧，特別請來冠軍調酒師研發結合印度香料的創意調酒，配上精緻下酒小吃，邀請客人放下緊繃享受餐前的輕鬆小酌；餐廳菜式除了經典北印料理與新鮮的烤窯菜式，更引進南印度馳名的海鮮風味、以及各式甜點。 在全新番紅花，味美依然，而每杯酒、每道菜、以及聚在一起分享異國美食的時光，更是一場探索香料，滿足味蕾和嗅覺的奇妙旅程。\u003c/p\u003e","image":"https://breeze-assets.breeze.com.tw/navigation/8c33ea9e4b94850ee6499db01a2e48b4c5fc6f1e.png","image_app":"https://breeze-assets.breeze.com.tw/navigation/36dfec57322a91976a96808398513e9182d5097c.png","floor":"46F"},{"branch_name":"微風南山","id":2757,"shop_id":"75040","shop_name":"MiraWan","description":"\u003cp\u003eMiraWan 原意為＂Miracle Taiwan 絢奇台灣＂，全台獨家高空景觀法式餐廳，跨越國界的精緻法式料理、嶄新侍酒體驗、高雅愜意的空間氛圍與絕佳景觀共譜愉悅的感官體驗。\u003c/p\u003e\r\n\r\n\u003cp\u003e到了深夜，酒吧展演各類精緻調飲與bar food，徜徉其中，將能感受台北夜時尚的美好\u003c/p\u003e","image":"https://breeze-assets.breeze.com.tw/navigation/f341599e249b5e7e0511a6c02b5b9ed52d9f7c93.png","image_app":"https://breeze-assets.breeze.com.tw/navigation/a437ecaf3a40f865ce1a1ea9d42a54122d4124ca.png","floor":"47F"}]}],"studio":[{"id":2,"name":"微風藝文中心","description":"位於台北東區黃金區域， 鄰近忠孝復興、忠孝敦化、南京復興捷運站， 地處台北市市中心購物中心微風廣場之8到9樓。","top_banner":"https://breeze-assets.breeze.com.tw/navigation/e10d5ede1bcff2ae4a82c389a30221e3ed922a1d.png","official_image":"https://breeze-assets.breeze.com.tw/navigation/7ab28342418d8796f3f53bf42625372d4ffdd4f3.png","pdf":"https://breeze-assets.breeze.com.tw/navigation/4912435db1d2e5c9f1f2206065fd944259c6c91e.pdf","en_pdf":"https://breeze-assets.breeze.com.tw/navigation/b8bcb7e6de3b16fed4bb6683a4cff523eb21d28e.pdf","branch_id":"001","branch_name":"微風廣場","posts":[],"images":[{"img_url":"https://breeze-assets.breeze.com.tw/navigation/b736ad542718cf3a07942d10d4aca907415911cf.png","title":""},{"img_url":"https://breeze-assets.breeze.com.tw/navigation/ee016b11bf05c78f30699ac615718e5d57212e51.png","title":""},{"img_url":"https://breeze-assets.breeze.com.tw/navigation/8dbddb6a03be0ad01732583c1805f084265c6b66.png","title":""}]},{"id":3,"name":"微風南山 藝文中心","description":"微風南山藝文中心結合藝術、人文、文化、公益社會關懷， 創造專屬的藝文價值，以多元化活動溫暖人心增添信義區內之藝術氛圍。","top_banner":"https://breeze-assets.breeze.com.tw/navigation/e6336667b909fe411229ef077163871a6caac831.png","official_image":"https://breeze-assets.breeze.com.tw/navigation/57373637e8cf0ad346075edea0ca9f9643f2f08f.png","pdf":"https://breeze-assets.breeze.com.tw/navigation/0124af905fa91a162c26fe14f4b24960e4adbbfd.pdf","en_pdf":"https://breeze-assets.breeze.com.tw/navigation/09fb5230157d30f1d158d39baa1d7de7ff1b5b5d.pdf","branch_id":"012","branch_name":"微風南山","posts":[],"images":[{"img_url":"https://breeze-assets.breeze.com.tw/navigation/585e86225689bc96f598f5a4c6698dfdf583107d.png","title":""}]}],"esg":[{"id":1098,"title":"2026.05.09【早產兒回娘家】榮總病童關懷活動","img":"https://breeze-assets.breeze.com.tw/navigation/thumbnail_paper_202605141555362.jpg?1791702401272","event_time":" ~ ","release_date":"2026-05-14","branches":""},{"id":1090,"title":"2026.05【微風輕撫 希望的微笑】榮總公益策展","img":"https://breeze-