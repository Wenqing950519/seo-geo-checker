.elementor-2195 .elementor-element.elementor-element-15432f3 .page-numbers{
    position: relative;
}
.elementor-2195 .elementor-element.elementor-element-15432f3 .page-numbers:after{
    content:"";
    background: rgba(255,255,255,0);
    width:30px;
    height: 30px;
    position: absolute;
    left: 50%;
    top:50%;
    transform: translate(-50%,-50%);
    z-index: -1;
    border-radius: 99%;
}
.elementor-2195 .elementor-element.elementor-element-15432f3 .page-numbers:hover:after,.elementor-2195 .elementor-element.elementor-element-15432f3 .page-numbers.current:after{
