    margin: 0 20px;
}
.elementor-2195 .elementor-element.elementor-element-14a0470 .elementor-nav-menu>li:not(:last-child):after{
    content:"";
    background: #3F2313;
    width: 1px;
    height: 40px;
    position: absolute;
    right:-20px;
    opacity: .7;
}

@media(max-width:525px){
    .elementor-2195 .elementor-element.elementor-element-14a0470 .elementor-nav-menu>li:not(:last-child):after{
