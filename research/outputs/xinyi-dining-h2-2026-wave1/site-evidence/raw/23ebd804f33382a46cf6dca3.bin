/* Start custom CSS for nav-menu, class: .elementor-element-14a0470 */.elementor-2195 .elementor-element.elementor-element-14a0470 ul.elementor-nav-menu {
    padding: 0;
    margin: 0 auto;
}

.elementor-2195 .elementor-element.elementor-element-14a0470 a.elementor-item.menu-link {
    border: 1px solid #3F2313;
    padding: 8px 24px;
    border-radius: 21px;
}
.elementor-2195 .elementor-element.elementor-element-14a0470 a.elementor-item.menu-link:hover,.elementor-2195 .elementor-element.elementor-element-14a0470 a.elementor-item.menu-link.elementor-item-active{
