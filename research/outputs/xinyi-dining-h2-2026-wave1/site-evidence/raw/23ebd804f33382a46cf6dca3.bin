document.addEventListener('wpcf7beforesubmit', function (event) {
    const form = event.target;
    const submitBtn = form.querySelector('input[type="submit"], button[type="submit"]');
    if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.dataset.originalText = submitBtn.value || submitBtn.innerText;
        submitBtn.value = '送出中...';
    }
}, false);

document.addEventListener('wpcf7invalid', function (event) {
    resetSubmit(event.target);
}, false);

document.addEventListener('wpcf7fail', function (event) {
    resetSubmit(event.target);
}, false);

document.addEventListener('wpcf7mailsent', function (event) {
    resetSubmit(event.target);
}, false);

function resetSubmit(form) {
    const submitBtn = form.querySelector('input[type="submit"], button[type="submit"]');
    if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.value = submitBtn.dataset.originalText || '送出';
    }
}
</script>

