    <script>
      // // disable scrollmagic
      jQuery( document ).ready( function($) {

        var tooSmall = false;
        var controller = null;
        var maxWidth = 1025; // or whatever your max width is

        if( $(window).width() < maxWidth ) {
          tooSmall = true;
        }
        
        $('#submitBtn').click(function(){

		var ContactName =$("#ContactName").val().trim();
	    var ContactEmail =$("#ContactEmail").val().trim();
	    var ContactContent = $("#ContactContent").val();
	    
	    
	    if(ContactName==""){
         $('#ContactName').parent('.field-container').addClass("error");
	         return;
	     }
	     else{
	         $('#ContactName').parent('.field-container').removeClass("error");
	     }
	
	     if(ContactEmail==""){
	         $('#ContactEmail').parent('.field-container').addClass("error");
	         return;
	     }
	     else{
	         $('#ContactEmail').parent('.field-container').removeClass("error");
	     }
	
	
	 
	     if(ContactContent==""){
	         $('#ContactContent').parent('.field-container').addClass("error");
	         return;
	     }
	     else{
	         $('#ContactContent').parent('.field-container').removeClass("error");
	     }
	    	 
	     $('#contactForm').submit();
	});


        function initScrollMagic() {
          $('body').scrollTop( 0 );

          // parallax
          var controller = new ScrollMagic.Controller();


          $(".scroll-container").each(function() {
              // 

              var parallaxImage = TweenMax.to($(this).find(".speed-green"), 1, {
                  y: $(".speed-green").position().top 
              });
              var projectImage = new ScrollMagic.Scene({
                      triggerElement: this,
                      triggerHook: 1,
                      duration: '120%'
                  })
                  .setTween(parallaxImage)
                  .addTo(controller);
              // 

              var parallaxImage = TweenMax.to($(this).find(".speed-chef"), 1, {
                  y: $(".speed-chef").position().top + 80
              });
              var projectImage = new ScrollMagic.Scene({
                      triggerElement: this,
                      triggerHook: 1,
                      duration: '200%'
                  })
                  .setTween(parallaxImage)
                  .addTo(controller);
              //
              var parallaxImage = TweenMax.to($(this).find(".speed-box"), 1, {
                  y: $(".speed-box").position().top + 300
              });

              var projectImage = new ScrollMagic.Scene({
                      triggerElement: this,
                      triggerHook: 0.1,
                      duration: '180%'
                  })
                  .setTween(parallaxImage)
                  .addTo(controller);
              // 

              var parallaxImage = TweenMax.to($(this).find(".speed-transparent"), 1, {
                  y: '270%'
              });

              console.log( $(".speed-transparent").offset().top - $(".square-info").offset().top)


              var projectImage = new ScrollMagic.Scene({
                      triggerElement: this,
                      triggerHook: 1,
                      duration: '250%'
                  })
                  .setTween(parallaxImage)
                  .addTo(controller);
              //
              var parallaxImage = TweenMax.to($(this).find(".speed-food"), 1, {
                  y: $(".speed-food").position().top +50
              });
              var projectImage = new ScrollMagic.Scene({
                      triggerElement: this,
                      triggerHook: 1,
                      duration: '300%'
                  })
                  .setTween(parallaxImage)
                  .addTo(controller);
              //
              var parallaxImage = TweenMax.to($(this).find(".speed-menu"), 1, {
                  y: '220%'
              });
              var projectImage = new ScrollMagic.Scene({
                      triggerElement: this,
                      triggerHook: -2,
                      duration: '320%'
                  })
                  .setTween(parallaxImage)
                  .addTo(controller);



               // $(window).trigger('resize');

          });
          var controller = new ScrollMagic.Controller();

          $(".single-image").each(function() {

              var parallaxImage = TweenMax.to($(this).find(".single-image-container"), 1, {
                  y: '-5%'
              });

              var projectImage = new ScrollMagic.Scene({
                      triggerElement: this,
                      triggerHook: 1,
                      duration: '140%'
                  })
                  .setTween(parallaxImage)
                  .addTo(controller);

          });
        }

        if( !tooSmall ) {
          initScrollMagic();
        }

        // part of the problem is that window resizes can trigger multiple times as the events fire rapidly
        // this solution prevents the controller from being initialized/destroyed more than once
        $(window).resize( function() {
          var wWidth = $(window).width();
          if( wWidth < maxWidth ) {
            if( controller !== null && controller !== undefined ) {
              // completely destroy the controller
              controller = controller.destroy( true );
              // if needed, use jQuery to manually remove styles added to DOM elements by GSAP etc. here
            }
          } else if( wWidth >= maxWidth ) {
            if( controller === null || controller === undefined ) {
              // reinitialize ScrollMagic only if it is not already initialized
              initScrollMagic();
            }
          }
        });

        if ($(window).width() < 699) {
          $('nav a').click(function(){
            $('nav').removeClass('open');
            $('.menu-burger').removeClass('hidden');
          })
        }
        else {
        }

      });
    </script>
</body>

