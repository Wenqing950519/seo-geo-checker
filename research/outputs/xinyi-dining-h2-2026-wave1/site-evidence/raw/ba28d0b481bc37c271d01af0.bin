<style type="text/css">/* 主輪播：完整露出＋等比例 */
.sw-slider{
  position: relative;
  width: 100%;
  margin: auto;
  overflow: hidden;
  background: #000; /* 留白底色，可改 transparent */
}

/* 疊在一起淡入淡出 */
.sw-slider .sw-slide{
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 1s ease-in-out;
}
.sw-slider .sw-slide.is-active{ opacity: 1; }

/* ✅完整露出（不裁切） */
.sw-slider .sw-slide img{
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

/* Popup fade */
.sw-fade{
  position: relative;
  width: 100%;
  margin: 0 auto;
  overflow: hidden;
  border-radius: 12px;
}
.sw-fade .sw-fade__item{
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity .9s ease-in-out;
  pointer-events: none;
}
.sw-fade .sw-fade__item.is-active{
  opacity: 1;
  pointer-events: auto;
}
.sw-fade img{
  width: 100%;
  height: auto;
  display: block;
}
</style>
<script>
(function(){
  function setAspectByImage(root, img){
    const apply = () => {
      const w = img.naturalWidth, h = img.naturalHeight;
      if(!w || !h) return;

      root.style.aspectRatio = `${w} / ${h}`;

      // fallback
      const widthPx = root.clientWidth || root.getBoundingClientRect().width;
      if (!CSS.supports('aspect-ratio: 1 / 1')) {
        root.style.height = (widthPx * h / w) + 'px';
      }
    };

    if (img.complete) apply();
    else img.addEventListener('load', apply, { once:true });
  }

  function initSwSlider(){
    document.querySelectorAll('.sw-slider[data-autoplay="true"]').forEach((slider) => {
      const slides = Array.from(slider.querySelectorAll('.sw-slide'));
      if (!slides.length) return;

      let idx = slides.findIndex(s => s.classList.contains('is-active'));
      if (idx < 0) idx = 0;
      slides.forEach((s, i) => s.classList.toggle('is-active', i === idx));

      const img0 = slides[idx].querySelector('img');
      if (img0) setAspectByImage(slider, img0);

      const interval = parseInt(slider.getAttribute('data-interval') || '3000', 10);

      // 避免 Barba/重複初始化造成多個 setInterval
      if (slider.__swTimer) clearInterval(slider.__swTimer);

      if (slides.length > 1){
        slider.__swTimer = setInterval(() => {
          slides[idx].classList.remove('is-active');
          idx = (idx + 1) % slides.length;
          slides[idx].classList.add('is-active');

          const img = slides[idx].querySelector('img');
          if (img) setAspectByImage(slider, img);
        }, interval);
      }

      // resize
      if (!slider.__swResizeBound){
        slider.__swResizeBound = true;
        window.addEventListener('resize', () => {
          const img = slides[idx]?.querySelector('img');
          if (img) setAspectByImage(slider, img);
        });
      }
    });
  }

  function initSwFade(){
    document.querySelectorAll('.sw-fade').forEach((root) => {
      const items = Array.from(root.querySelectorAll('.sw-fade__item'));
      if (!items.length) return;

      let idx = items.findIndex(s => s.classList.contains('is-active'));
      if (idx < 0) idx = 0;
      items.forEach((s, i) => s.classList.toggle('is-active', i === idx));

      const img0 = items[idx].querySelector('img');
      if (img0) setAspectByImage(root, img0);

      const interval = parseInt(root.getAttribute('data-interval') || '4000', 10);

      if (root.__fadeTimer) clearInterval(root.__fadeTimer);

      if (items.length > 1){
        root.__fadeTimer = setInterval(() => {
          items[idx].classList.remove('is-active');
          idx = (idx + 1) % items.length;
          items[idx].classList.add('is-active');

          const img = items[idx].querySelector('img');
          if (img) setAspectByImage(root, img);
        }, interval);
      }
    });
  }

  // ✅ DOM ready 後再跑，避免抓不到節點
  document.addEventListener('DOMContentLoaded', () => {
    initSwSlider();
    initSwFade();
  });

  // ✅ 如果你有用 Barba 換頁，下一頁也要重跑（保守不報錯）
  document.addEventListener('barba:after', () => {
    initSwSlider();
    initSwFade();
  });
})();
</script>

