    transition: width 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* 2. The Text Wrapper Base State */
  [data-view-text="true"] {
    transition: opacity 0.3s ease, transform 0.3s ease;
    opacity: 1;
    transform: translate(0px, 0px);
  }

  /* --- GRID TO LIST (ENTRY SEQUENCE) --- */
  /* Hide text at the bottom-left while the image is shrinking */
  [data-view-text="true"].is-list-view {
    opacity: 0;
    transform: translate(-30px, 30px); /* South-West starting point */
  }
  /* Class added by JS after the image finishes shrinking */
  [data-view-text="true"].show-list-text {
    opacity: 1;
    transform: translate(0px, 0px); /* Slides North-East to normal position */
  }

  /* --- LIST TO GRID (EXIT SEQUENCE) --- */
  /* Class added by JS to slide text South-West before the image expands */
  [data-view-text="true"].hide-list-text {
    opacity: 0;
    transform: translate(-30px, 30px); /* Slides away */
  }
</style></div><div class="u-embed-js w-embed w-script"><script>
document.addEventListener("DOMContentLoaded", () => {
  const wrappers = document.querySelectorAll('[data-view-wrapper="true"]:not([data-initialized])');
  
  wrappers.forEach(wrapper => {
    wrapper.setAttribute('data-initialized', 'true');

    const gridBtn = wrapper.querySelector('[data-action="set-grid-view"]');
    const listBtn = wrapper.querySelector('[data-action="set-list-view"]');
    
    const allViewElements = wrapper.querySelectorAll('[data-view-element="true"]');
    const textElements = wrapper.querySelectorAll('[data-view-text="true"]'); 
    const storageKey = wrapper.getAttribute('data-storage-key') || 'default-view';

    let isAnimating = false; 

    function setView(viewType, isLoad = false) {
      if (isAnimating) return; 

      const currentView = localStorage.getItem(storageKey) || "grid";
      if (!isLoad && currentView === viewType) return; 

      isAnimating = true;

      if (viewType === 'list') {
        // 1. Swap the layout and trigger the image shrink
        allViewElements.forEach(el => el.classList.add("is-list-view"));
        
        if(listBtn) listBtn.classList.add("is-active");
        if(gridBtn) gridBtn.classList.remove("is-active");

        // 2. Wait 450ms (giving the image full time to shrink), then slide text NE
        setTimeout(() => {
          textElements.forEach(el => el.classList.add("show-list-text"));
          isAnimating = false;
        }, (isLoad ? 0 : 450)); 

        localStorage.setItem(storageKey, "list");

      } else {
        // 1. Hide the text first (slides South-West)
        textElements.forEach(el => el.classList.remove("show-list-text"));
        textElements.forEach(el => el.classList.add("hide-list-text"));
        
        if(gridBtn) gridBtn.classList.add("is-active");
        if(listBtn) listBtn.classList.remove("is-active");

        // 2. Wait 350ms for text to disappear, then expand image and revert layout
        setTimeout(() => {
          allViewElements.forEach(el => el.classList.remove("is-list-view"));
          textElements.forEach(el => el.classList.remove("hide-list-text")); 
          isAnimating = false;
        }, (isLoad ? 0 : 350)); 

        localStorage.setItem(storageKey, "grid");
      }
    }

    const savedView = localStorage.getItem(storageKey) || "grid";
    setView(savedView, true); 

    if (gridBtn && listBtn) {
        gridBtn.addEventListener("click", () => setView("grid"));
        listBtn.addEventListener("click", () => setView("list"));
    }
  });
});
</script></div></section><section data-show="True" class="popup_wrap"><div class="popup_content is-desktop"><div class="popup_clw w-dyn-list"><div class="w-dyn-empty"><div>No items found.</div></div></div></div><div class="popup_content is-mobile"><div class="popup_clw w-dyn-list"><div class="w-dyn-empty"><div>No items found.</div></div></div></div><div class="popup_overlay"></div><div class="u-embed-js w-embed w-script"><script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".popup_wrap").forEach((component) => {
    if (component.dataset.scriptInitialized) return;
    component.dataset.scriptInitialized = "true";
    (function () {
  const popupWrap = document.querySelector('.popup_wrap');
  const triggers = document.querySelectorAll('.popup_close_wrap, .popup_overlay');

  triggers.forEach(el => {
    el.addEventListener('click', () => {
      popupWrap.style.display = 'none';
    });
  });
})();
  });
});
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".w-dyn-list").forEach(function (list) {
    if (list.querySelector(".w-dyn-empty")) {
      var section = list.closest("section");
      if (section) {
        section.style.display = "none";
      }
    }
  });
});
</script></div></section></main><footer class="footer_wrap"><h2 class="footer_title u-sr-only">Footer</h2><div class="footer_contain u-container"><div data-medium-columns="1" class="footer_layout"><div class="footer_content u-grid-custom"><div class="footer_column"><div class="footer_column_title u-text-transform-uppercase u-weight-bold"><div>About</div></div><div data-number="37" data-wf--typography-paragraph--variant="text-small" class="u-text w-variant-4099173f-f581-635c-a5fe-cf4a89c62029 u-rich-text w-richtext u-margin-bottom-0"><p>Inspired by the vibrant diversity of Southeast Asia, where cultures converge and connections thrive, CÉ LA VI blends modern Asian flavours, dynamic spaces, and electrifying atmospheres.</p><p>Our name embodies the spirit of living life to the fullest, embracing the moment and indulging in the finest things the world has to offer. Renowned for our iconic rooftop locations and elevated guest experiences, each destination unfolds as a distinct expression of connection, celebration, and discovery.</p><p>CÉ LA VI’s global footprint spans Singapore, Taipei, Tokyo, Dubai, and London, with new destinations anticipated<strong> </strong>in major cities around the world.</p></div></div><div class="footer_column is-border-black"><div class="footer_column_title u-text-transform-uppercase u-weight-bold"><div>Our Newsletter</div></div><div data-number="60" data-wf--typography-paragraph--variant="text-small" class="u-text w-variant-4099173f-f581-635c-a5fe-cf4a89c62029 u-rich-text w-richtext u-margin-bottom-0 u-margin-bottom-4"><p>Subscribe to our newsletter to receive exclusive updates, event invitations and news delivered directly to your inbox</p></div><div class="footer-contact_form"><div class="footer-form_component"><div class="footer-form_wrap w-form"><form id="wf-form-Newsletter-Form" name="wf-form-Newsletter-Form" data-name="Newsletter Form" method="get" class="footer-form_element" data-wf-page-id="69d34162c496bedfc8fe04c5" data-wf-element-id