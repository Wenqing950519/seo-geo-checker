3.0428H52.8296V38.8125H70.9158V34.7082H52.8296V21.9288H75.6532V17.832H48.4375V57.138H75.6532V53.0413V53.0428Z" fill="currentColor"></path><path d="M21.2205 21.6096C25.499 21.6096 29.5215 23.3058 32.546 26.3939L32.6278 26.4757L35.7992 23.6163L35.7174 23.5269C30.506 18.1777 24.3995 17.375 21.2205 17.375C10.1328 17.3826 1.10938 26.403 1.10938 37.4861C1.10938 48.5693 10.1328 57.5897 21.2205 57.5897C24.4252 57.5897 30.5635 56.787 35.7174 51.4378L35.7992 51.3469L32.6278 48.4875L32.546 48.5693C29.5473 51.6907 25.5232 53.4112 21.2205 53.4112C12.5257 53.4112 5.46207 46.2597 5.46207 37.4771C5.46207 28.6944 12.5348 21.6005 21.2205 21.6005V21.608V21.6096Z" fill="currentColor"></path><path d="M108.771 17.8008H104.379V57.1068H131.595V53.0025H108.771V17.8008Z" fill="currentColor"></path><path d="M218.334 48.3601L201.812 17.9019L201.763 17.8125H196.691L218.244 57.1185L218.35 57.3154L238.534 18.0669L238.666 17.8125H233.594L218.335 48.3616L218.334 48.3601Z" fill="currentColor"></path></g><defs><clippath id="clip0_346_849"><rect width="255.694" height="58.5039" fill="currentColor"></rect></clippath></defs></svg></div></a><div id="w-node-a0394faf-a53f-7e7b-ecb7-ec42c8fe4987-3814999f" class="footer_bottom_right"><div class="footer_bottom_text"><span>Copyright </span><span data-dynamic-year=" ">{{year}}</span><span> CÉ LA VI All Rights Reserved</span></div></div></div></div></div><div class="u-embed-js w-embed w-script"><script>
