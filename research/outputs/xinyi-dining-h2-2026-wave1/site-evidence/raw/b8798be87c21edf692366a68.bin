<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WL27QWL" height="0" width="0" style="display: none; visibility: hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
<script>
  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('load', function () {
    setTimeout(function () {
      // Check if we're on mobile/tablet (below 992px - Webflow's tablet breakpoint)
      const isMobile = window.innerWidth < 992;

      if (isMobile) {
        console.log('Mobile/Tablet detected - Pinning disabled, using natural scroll');
        // On mobile, just ensure columns can scroll naturally
        const scrollContainers = document.querySelectorAll('.events-scroll');
        scrollContainers.forEach((container) => {
          container.style.overflowY = 'visible';
          container.style.height = 'auto';
        });
        return; // Exit early, don't create ScrollTrigger
      }

      console.log('Desktop detected - Enabling pin & scroll interaction');

      // Get your specific Webflow elements
      const triggerLine = document.querySelector('.events-trigger-line');
      const eventnewColumns = document.querySelector('.eventnew-columns');
      const scrollContainers = document.querySelectorAll('.events-scroll');

      // Validation
      if (!triggerLine) {
        console.error('ERROR: .events-trigger-line not found!');
        return;
      }

      if (!eventnewColumns) {
        console.error('ERROR: .eventnew-columns not found!');
        return;
      }

      if (scrollContainers.length === 0) {
        console.error('ERROR: .events-scroll containers not found!');
        return;
      }

      console.log('Found trigger line:', triggerLine);
      console.log('Found columns wrapper:', eventnewColumns);
      console.log('Found scroll containers:', scrollContainers.length);

      // Find navbar
      const navbar = document.querySelector('.navbar') || document.querySelector('.nav') || document.querySelector('[class*="nav"]');

      const navbarHeight = navbar ? navbar.offsetHeight : 96;
      console.log('Navbar height:', navbarHeight + 'px');

      // ADJUSTMENT: Add spacing buffer above trigger line before pinning starts
      // Increase this value (in pixels) to show more of the trigger line before pin
      const spacingAboveTrigger = 8; // Change this value as needed (e.g., 50, 100, 150)

      // Calculate content heights
      let maxContentHeight = 0;
      scrollContainers.forEach((container, index) => {
        const contentHeight = container.scrollHeight;
        const eventnewCl = container.querySelector('.eventnew_cl');

        if (contentHeight > maxContentHeight) {
          maxContentHeight = contentHeight;
        }

        console.log(`Column ${index + 1}:`);
        console.log(`   - events-scroll scrollHeight: ${contentHeight}px`);
        if (eventnewCl) {
          console.log(`   - eventnew_cl height: ${eventnewCl.scrollHeight}px`);
        }
      });

      const containerHeight = scrollContainers[0].offsetHeight;
      console.log(`Container visible height: ${containerHeight}px`);
      console.log(`Max content height: ${maxContentHeight}px`);

      // Calculate scroll distance needed
      const scrollDistance = Math.max(
        maxContentHeight - containerHeight + 500, // Content overflow + buffer
        window.innerHeight * 2.5, // Minimum 2.5x viewport height
      );

      console.log(`Scroll distance set to: ${scrollDistance}px`);
      console.log(`Spacing above trigger line: ${spacingAboveTrigger}px`);

      // Create the ScrollTrigger with adjusted start position
      ScrollTrigger.create({
        trigger: triggerLine,
        start: `top ${navbarHeight + spacingAboveTrigger}px`, // Add spacing buffer here
        end: `+=${scrollDistance}`,
        pin: eventnewColumns,
        pinSpacing: true,
        anticipatePin: 1,
        markers: false, // Set to true during development to visualize trigger points
        id: 'eventColumnsPin',

        onEnter: () => {
          console.log('PINNED - Adding is-scrolling class');

          scrollContainers.forEach((container, index) => {
            // Add class to events-scroll
            container.classList.add('is-scrolling');

            // Also add to eventnew_cl if it exists
            const eventnewCl = container.querySelector('.eventnew_cl');
            if (eventnewCl) {
              eventnewCl.classList.add('is-scrolling');
            }

            console.log(`  Column ${index + 1}: is-scrolling class added`);

            // Debug info after a moment
            setTimeout(() => {
              const styles = window.getComputedStyle(container);
              console.log(`  Column ${index + 1} computed overflow-y: ${styles.overflowY}`);
              console.log(`  scrollHeight: ${container.scrollHeight}px`);
              console.log(`  clientHeight: ${container.clientHeight}px`);
              console.log(`  Can scroll: ${container.scrollHeight > container.clientHeight}`);
            }, 100);
          });
        },

        onLeaveBack: () => {
          console.log('UNPINNED - Removing is-scrolling class');

          scrollContainers.forEach((container, index) => {
            // Remove class from events-scroll
            container.classList.remove('is-scrolling');

            // Also remove from eventnew_cl
            const eventnewCl = container.querySelector('.eventnew_cl');
            if (eventnewCl) {
              eventnewCl.classList.remove('is-scrolling');
            }

            // Reset scroll position
            container.scrollTop = 0;

            console.log(`  Column ${index + 1}: is-scrolling class removed and reset`);
          });
        },
      });

      console.log('ScrollTrigger initialized successfully!');
      console.log('"is-scrolling" class will be added when pinned');

      // Refresh ScrollTrigger
      ScrollTrigger.refresh();

      // SCROLL TO TOP BUTTON FUNCTIONALITY
      const scrollToTopBtn = document.getElementById('scrollToTop');

      if (scrollToTopBtn) {
        console.log('✅ Found scrollToTop button');

        scrollToTopBtn.addEventListener('click', function (e) {
          e.preventDefault();
          console.log('🔝 Scroll to top triggered');

          // FIRST: Reset scroll for events-scroll containers
          scrollContainers.forEach((container, index) => {
            container.scrollTop = 0;
            console.log(`  → events-scroll ${index + 1} reset to: ${container.scrollTop}`);
          });

          // SECOND: Reset scroll for eventnew_cl elements (which have is-scrolling class)
          const eventnewClElements = document.querySelectorAll('.eventnew_cl.is-scrolling');
          eventnewClElements.forEach((el, index) => {
            el.scrollTop = 0;
            console.log(`  → eventnew_cl ${index + 1} reset to: ${el.scrollTop}`);
          });

          // THEN: Smooth scroll the page to top
          window.scrollTo({
            top: 0,
            behavior: 'smooth',
          });

          // Remove is-scrolling class
          scrollContainers.forEach((container) => {
            const eventnewCl = container.querySelector('.eventnew_cl');
            container.classList.remove('is-scrolling');
            if (eventnewCl) {
              eventnewCl.classList.remove('is-scrolling');
            }
          });

          // Double-check after a moment and force again if needed
          setTimeout(() => {
            // Check events-scroll
            scrollContainers.forEach((container, index) => {
              if (container.scrollTop !== 0) {
                console.warn(`  ⚠️ events-scroll ${index + 1} didn't reset, forcing again...`);
                container.scrollTop = 0;
              }
            });

            // Check eventnew_cl
            const eventnewClElements = document.querySelectorAll('.eventnew_cl');
            eventnewClElements.forEach((el, index) => {
              if (el.scrollTop !== 0) {
                console.warn(`  ⚠️ eventnew_cl ${index + 1} didn't reset, forcing again...`);
                el.scrollTop = 0;
              }
            });

            console.log('✅ All scrolls confirmed at top');
          }, 100);
        });
      } else {
        console.warn('⚠️ scrollToTop button not found - make sure element has id="scrollToTop"');
      }
    }, 150);
  });

  // Refresh on window resize and handle mobile/desktop switching
  let resizeTimer;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () {
      const isMobile = window.innerWidth < 992;

      if (isMobile) {
        // Kill all ScrollTriggers on mobile
        ScrollTrigger.getAll().forEach((trigger) => trigger.kill());

        // Reset to natural scroll
        const scrollContainers = document.querySelectorAll('.events-scroll');
        scrollContainers.forEach((container) => {
          container.classList.remove('is-scrolling');
          container.style.overflowY = 'visible';
          container.style.height = 'auto';
        });

        console.log('Switched to mobile - pinning disabled');
      } else {
        // Reload the page to reinitialize ScrollTrigger properly
        location.reload();
      }
    }, 250);
  });
</script>

<script>
  window.addEventListener('load', function () {
    // minimiseWeeklyBtn scrolls to columnWeekly
    const minimiseWeeklyBtn = document.getElementById('minimiseWeeklyBtn');
    const columnWeeklyHighlight = document.getElementById('columnHighlight');

    if (minimiseWeeklyBtn && columnWeeklyHighlight) {
      minimiseWeeklyBtn.addEventListener('click', function () {
        setTimeout(function () {
          const elementPosition = columnWeeklyHighlight.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - 300;

          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth',
          });
        }, 100);
      });
    }

    // minimiseHighlight scrolls to columnHighlight
    const minimiseHighlight = document.getElementById('minimiseHighlight');
    const columnHighlight = document.getElementById('columnHighlight');

    if (minimiseHighlight && columnHighlight) {
      minimiseHighlight.addEventListener('click', function () {
        setTimeout(function () {
          const elementPosition = columnHighlight.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - 300;

          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth',
          });
        }, 100);
      });
    }
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const popupWrap = document.querySelector('.popup_wrap');
    const closeBtns = document.querySelectorAll('.popup_close_wrap');
    const overlay = document.querySelector('.popup_overlay');

    const shouldShow = popupWrap?.dataset?.show === 'true';
    const hasShown = sessionStorage.getItem('eventPopupShown');

    if (popupWrap && shouldShow && !hasShown) {
      popupWrap.classList.add('is-visible');
      sessionStorage.setItem('eventPopupShown', 'true');
    }

    function closePopup() {
      popupWrap?.classList.remove('is-visible');
    }

    // Attach close handler to all close buttons
    closeBtns.forEach((btn) => btn.addEventListener('click', closePopup));

    // Overlay click to close
    overlay?.addEventListener('click', closePopup);
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const scrollButtons = document.querySelectorAll('.to-page-top_wrap');

    scrollButtons.forEach((button) => {
      // Set the initial transition and hidden state
      button.style.transition = 'opacity 0.3s ease, visibility 0.3s ease';
      button.style.opacity = '0';
      button.style.visibility = 'hidden';

      // Handle the click to scroll up
      button.addEventListener('click', function (e) {
        e.preventDefault();
        window.scrollTo({
          top: 0,
          behavior: 'smooth',
        });
      });
    });

    window.addEventListener('scroll', () => {
      // Check how far down we've scrolled (in pixels)
      const scrollPosition = window.scrollY || document.documentElement.scrollTop;

      scrollButtons.forEach((button) => {
        // If scrolled past 20px, show it. Otherwise, hide it.
        if (scrollPosition > 20) {
          button.style.opacity = '1';
          button.style.visibility = 'visible';
        } else {
          button.style.opacity = '0';
          button.style.visibility = 'hidden';
        }
      });
    });
  });
</script></body></html>