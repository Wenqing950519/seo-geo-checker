90b-9842-2d7e6f6bf325 nav_dropdown_right"><div data-wf--nav-image-block--variant="default" class="nav_image_wrap"><div class="new-nav_menu_image is-default"><img loading="lazy" src="https://cdn.prod.website-files.com/69d34162c496bedfc8fe04f0/69d352fab2ff93594874cf9d_celavi-tw_navmenu_default.avif" alt="" class="nav_menu_img"/></div><div data-venue="" class="new-nav_menu_image"><img loading="lazy" src="https://cdn.prod.website-files.com/69d34162c496bedfc8fe04f0/69d352fab2ff93594874cf9d_celavi-tw_navmenu_default.avif" alt="" class="nav_menu_img"/></div></div><div data-wf--nav-image-block--variant="hover" class="nav_image_wrap"><div class="new-nav_menu_image w-variant-42065329-3cf9-1ccd-31bf-123dd31067ef is-default"><img loading="lazy" src="https://cdn.prod.website-files.com/69d34162c496bedfc8fe04f0/69d352f8079c69e314a451e5_celavi-tw_navmenu_skybar.avif" alt="" sizes="(max-width: 1772px) 100vw, 1772px" srcset="https://cdn.prod.website-files.com/69d34162c496bedfc8fe04f0/69d352f8079c69e314a451e5_celavi-tw_navmenu_skybar-p-500.avif 500w, https://cdn.prod.website-files.com/69d34162c496bedfc8fe04f0/69d352f8079c69e314a451e5_celavi-tw_navmenu_skybar.avif 667w" class="nav_menu_img"/></div><div data-venue="skybar" class="new-nav_menu_image w-variant-42065329-3cf9-1ccd-31bf-123dd31067ef"><img loading="lazy" src="https://cdn.prod.website-files.com/69d34162c496bedfc8fe04f0/69d352f8079c69e314a451e5_celavi-tw_navmenu_skybar.avif" alt="" sizes="(max-width: 1772px) 100vw, 1772px" srcset="https://cdn.prod.website-files.com/69d34162c496bedfc8fe04f0/69d352f8079c69e314a451e5_celavi-tw_navmenu_skybar-p-500.avif 500w, https://cdn.prod.website-files.com/69d34162c496bedfc8fe04f0/69d352f8079c69e314a451e5_celavi-tw_navmenu_skybar.avif 667w" class="nav_menu_img"/></div></div><div data-wf--nav-image-block--variant="hover" class="nav_image_wrap"><div class="new-nav_menu_image w-variant-42065329-3cf9-1ccd-31bf-123dd31067ef is-default"><img loading="lazy" src="https://cdn.prod.website-files.com/69d34162c496bedfc8fe04f0/69d352fa348f95a603c4c015_celavi-tw_navmenu_boon.avif" alt="" class="nav_menu_img"/></div><div data-venue="boon" class="new-nav_menu_image w-variant-42065329-3cf9-1ccd-31bf-123dd31067ef"><img loading="lazy" src="https://cdn.prod.website-files.com/69d34162c496bedfc8fe04f0/69d352fa348f95a603c4c015_celavi-tw_navmenu_boon.avif" alt="" class="nav_menu_img"/></div></div><div data-wf--nav-image-block--variant="hover" class="nav_image_wrap"><div class="new-nav_menu_image w-variant-42065329-3cf9-1ccd-31bf-123dd31067ef is-default"><img loading="lazy" src="https://cdn.prod.website-files.com/69d34162c496bedfc8fe04f0/69d352fa2b009277c12702a8_celavi-tw_navmenu_lounge.avif" alt="" class="nav_menu_img"/></div><div data-venue="lounge" class="new-nav_menu_image w-variant-42065329-3cf9-1ccd-31bf-123dd31067ef"><img loading="lazy" src="https://cdn.prod.website-files.com/69d34162c496bedfc8fe04f0/69d352fa2b009277c12702a8_celavi-tw_navmenu_lounge.avif" alt="" class="nav_menu_img"/></div></div></div></div></div></div></div></div></div></div></div><div class="u-embed-js w-embed w-script"><script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.nav_wrap').forEach((component) => {
      if (component.dataset.scriptInitialized) return;
      component.dataset.scriptInitialized = 'true';

      const venueLinks = component.querySelectorAll('a[data-venue]');
      const venueImages = component.querySelectorAll('.new-nav_menu_image[data-venue]');
      const defaultImage = component.querySelector('.new-nav_menu_image.is-default');
      const triggers = component.querySelectorAll('.nav_hamburger');
      const menu = component.querySelector('.new-nav_menu_wrap');

      triggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          menu.classList.toggle('is-open');
          triggers.forEach((t) => t.classList.toggle('is-active'));
        });
      });

      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        venueLinks.forEach((link) => {
          link.addEventListener('mouseenter', () => {
            const venue = link.dataset.venue;
            defaultImage.classList.add('is-hidden');
            venueImages.forEach((img) => {
              img.classList.toggle('is-active', img.dataset.venue === venue);
            });
          });

          link.addEventListener('mouseleave', () => {
            venueImages.forEach((img) => img.classList.remove('is-active'));
            defaultImage.classList.remove('is-hidden');
          });
        });
      }
    });
  });

  // --- Shareable Modal Logic ---
  window.Webflow = window.Webflow || [];
  window.Webflow.push(function () {
    const PARAM_KEY = 'modal';

    // List of allowed modals
    const allowedModals = ['reservation-modal', 'menu-modal', 'skybar-menu', 'boon-menu', 'lounge-menu'];

    // 1. READ URL ON PAGE LOAD: Open modal if parameter exists
    const params = new URLSearchParams(window.location.search);
    const modalParam = params.get(PARAM_KEY);

    if (modalParam && allowedModals.includes(modalParam)) {
      const triggerToClick = document.querySelector(`[data-modal-trigger="${modalParam}"]`);
      if (triggerToClick) {
        triggerToClick.click();
      }
    }

    // 2. GENERATE SLUG ON CLICK: Update URL when user clicks a modal trigger
    const allTriggers = document.querySelectorAll('[data-modal-trigger]');

    allTriggers.forEach((trigger) => {
      trigger.addEventListener('click', function () {
        const modalName = this.getAttribute('data-modal-trigger');

        if (allowedModals.includes(modalName)) {
          const newUrl = window.location.pathname + '?modal=' + modalName;
          window.history.pushState({ path: newUrl }, '', newUrl);
        }
      });
    });

    // 3. REMOVE SLUG ON CLOSE: Clear URL when user closes the modal (Updated selector)
    const closeButtons = document.querySelectorAll('[data-modal-close]');

    closeButtons.forEach((btn) => {
      btn.addEventListener('click', function () {
        window.history.pushState({}, '', window.location.pathname);
      });
    });

    // Clear the URL if the user presses the 'Escape' key to close the modal
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        window.history.pushState({}, '', window.location.pathname);
      }
    });
  });
</script></div><dialog data-wf--modal--variant="full-screen" data-modal-target="reservation-modal" data-preview="False" class="modal_dialog"><div class="u-embed-css w-embed"><style>
.modal_dialog::backdrop { opacity: 0; }
