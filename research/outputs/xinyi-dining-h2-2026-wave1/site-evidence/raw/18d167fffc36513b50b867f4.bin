tt.com/content/dam/marriott-renditions/TPEWH/tpewh-restaurant-1471-hor-wide.jpg?output-quality=70&interpolation=progressive-bilinear&downsize=1336px:*","address":{"@type":"PostalAddress","streetAddress":"10 Zhongxiao East Road Sec. 5, Xinyi District","addressLocality":"Taipei","addressRegion":"","addressCountry":"Taiwan","postalCode":""}},{"@type":"BarOrPub","@id":"https://www.marriott.com/en-us/hotels/tpewh-w-taipei/dining/#6518021","name":"WET® Bar","description":"Escape the city's energy at WET® Bar, our stylish poolside bar in Xinyi, Taipei, serving craft cocktails, light bites, and vibrant outdoor ambiance.","servesCuisine":"Pub","telephone":"+886 2-77038887 ","acceptsReservations":"https://www.tablecheck.com/en/shops/w-hotel-woobar-wetbar/reserve","image":"https://cache.marriott.com/content/dam/marriott-renditions/TPEWH/tpewh-bar-9024-hor-wide.jpg?output-quality=70&interpolation=progressive-bilinear&downsize=1336px:*","address":{"@type":"PostalAddress","streetAddress":"10 Zhongxiao East Road Sec. 5, Xinyi District","addressLocality":"Taipei","addressRegion":"","addressCountry":"Taiwan","postalCode":""}}]}
