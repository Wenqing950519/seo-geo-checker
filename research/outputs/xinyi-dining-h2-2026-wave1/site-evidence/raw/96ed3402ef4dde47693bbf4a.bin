<!DOCTYPE html><html lang="zh-TW"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"><title>Meat Love 橡木炭火韓國烤肉 - 線上訂位</title><style>:root {
            --app-height: 100%;
        }
        
        * {
            box-sizing: border-box;
        }
        
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden; /* 關鍵：防止 body 滾動 */
        }
        
        .iframe-container {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100%;
            /* 多重 fallback */
            height: 100%;
            height: 100vh;
            height: 100dvh;
            height: -webkit-fill-available;
            height: var(--app-height);
            overflow: hidden;
            /* 處理 iPhone 瀏海和底部安全區域 */
            padding-top: env(safe-area-inset-top, 0);
            padding-bottom: env(safe-area-inset-bottom, 0);
        }
        
        .iframe-container iframe {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
        }</style></head><body><div class="iframe-container">
<iframe
src="https://inline.app/booking/-LVCnf3Rrn9UW7rpH50o:inline-live-2a466?language=zh-tw"
frameborder="0"
allowfullscreen
scrolling="yes">
</iframe></div> <script>// JavaScript 動態計算真實視窗高度
        function setAppHeight() {
            const doc = document.documentElement;
            doc.style.setProperty('--app-height', `${window.innerHeight}px`);
        }
        
        // 監聽各種可能改變高度的事件
        window.addEventListener('resize', setAppHeight);
        window.addEventListener('orientationchange', function() {
            // 方向改變時延遲執行，等待瀏覽器完成調整
            setTimeout(setAppHeight, 100);
        });
        
        // 初始化
        setAppHeight();
        
        // 頁面完全載入後再執行一次
